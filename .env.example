# Copy to `.env` for local development. `.env` is gitignored.
#
# Astro only exposes `PUBLIC_`-prefixed variables to the browser. Everything
# else is server-only and is read from the Cloudflare Worker environment in
# production (Workers & Pages → tilershub → Variables and Secrets).

# ── Public (safe to ship to the browser) ──────────────────────────────────────

# Google AdSense publisher ID, including the "ca-" prefix.
# Leave blank to disable AdSense entirely — the head tags and every AdSlot are
# skipped when this is empty, so local and preview builds serve no ads.
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# ── Server-only ───────────────────────────────────────────────────────────────

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Text.lk SMS authentication (server secrets; never PUBLIC_)
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=
SUPABASE_SEND_SMS_HOOK_SECRET=
# Public Turnstile site key; configure its secret separately in Supabase Auth.
PUBLIC_TURNSTILE_SITE_KEY=
