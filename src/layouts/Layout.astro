---
import { si as sinhalaText } from '../lib/sinhala.js'
import '../index.css'
import '../styles/theme-2026.css'
import '../styles/brand-mobile.css'
import AppShell from '../components/AppShell.jsx'
import DraftLinker from '../components/DraftLinker.jsx'
import { ADSENSE_CLIENT } from '../lib/adsense.js'

const user = Astro.locals.user

// The tab bar is role-dependent, so the role is resolved here rather than in
// the browser: deciding it client-side would mean the first paint shows the
// wrong nav and then swaps. Same rule Dashboard.jsx uses.
const role = await Astro.locals.accountRole()

const {
  title = "වැඩHUB · Sri Lanka's Services Marketplace",
  description = "Find service providers across Sri Lanka. Offer your skills, find work, or connect with the right person for your job.",
  ogImage = 'https://wedahub.lk/og.png',
  ogType = 'website',
  noindex = false,
} = Astro.props
const path = Astro.url.pathname
const SITE = 'https://wedahub.lk'
const FONT_HREF = 'https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Instrument+Sans:wght@400;500;600&family=Noto+Sans+Sinhala:wght@400;500;600;700&display=swap'
const canonicalUrl = `${SITE}${path}`

// Routes that must never carry ads: authentication, account areas, and the
// forms people use to post work or ask for a quote. Auto Ads would otherwise
// inject into all of them, which is both a conversion risk and the kind of
// thin/utility page AdSense policy is unhappy about. The verification meta tag
// still ships everywhere so Google can confirm ownership from any URL.
const AD_FREE_PREFIXES = [
  '/login',
  '/auth',
  '/account',
  '/dashboard',
  '/notifications',
  '/admin',
  '/post-project',
  '/join-wedahub',
  '/contact',
  '/verify-claim',
  '/offline',
]
const adsAllowed = false

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'වැඩHUB',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/icon-512.png` },
      sameAs: [
        'https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z',
        'https://www.facebook.com/share/g/1Dsc63BvXS/',
      ],
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', areaServed: 'LK' },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'වැඩHUB',
      description: "Sri Lanka's platform for people, skills and opportunities",
      publisher: { '@id': `${SITE}/#organization` },
      potentialAction: { '@type': 'SearchAction', target: `${SITE}/providers?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
    },
  ],
})
---
<!DOCTYPE html>
<html lang="si" data-lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{sinhalaText(title)}</title>
  <meta name="description" content={sinhalaText(description)} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="theme-color" content="#0B2A4A" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href="/sitemap.xml" />
  <!-- Open Graph -->
  <meta property="og:title" content={sinhalaText(title)} />
  <meta property="og:description" content={sinhalaText(description)} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="වැඩHUB" />
  <meta property="og:locale" content="si_LK" />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={sinhalaText(title)} />
  <meta name="twitter:description" content={sinhalaText(description)} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Structured data -->
  <script type="application/ld+json" set:html={orgSchema} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <!-- iOS PWA startup images (prevents white flash on launch) -->
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="වැඩHUB" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- A CSS @import would be render-blocking and serialised behind the sheet
       that contains it, so the pairing is loaded as a non-blocking link. -->
  <link href={FONT_HREF} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href={FONT_HREF} rel="stylesheet" /></noscript>
  <slot name="head" />
  <style is:global>
    html:not([data-lang="si"]) .si-text { display: none; }
    html[data-lang="si"] .en-text { display: none; }
  </style>

  <!-- Google Consent Mode v2 defaults, set before any tag can fire. Analytics
       and advertising storage stay denied until the visitor chooses; the
       banner below updates them. Required by Google's EU user consent policy
       and a precondition for serving ads. -->
  <script is:inline>
    ;(function () {
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      window.gtag = gtag

      var saved = null
      try { saved = localStorage.getItem('th_consent') } catch (e) {}
      var granted = saved === 'all'

      gtag('consent', 'default', {
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
        analytics_storage: granted ? 'granted' : 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
      })

      // GTM itself only loads once a choice exists, so a visitor who has not
      // answered never gets an analytics or advertising cookie at all.
      window.__thLoadGTM = function () {
        if (window.__thGTMLoaded) return
        window.__thGTMLoaded = true
        dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        var f = document.getElementsByTagName('script')[0]
        var j = document.createElement('script')
        j.async = true
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-MX727MR5'
        f.parentNode.insertBefore(j, f)
      }
      if (saved) window.__thLoadGTM()
    })()
  </script>

  <!-- Google AdSense. Deliberately after the consent block above: the script
       reads the Consent Mode defaults that block registers, and loading it
       first would let it set an advertising cookie before the visitor has
       answered. Denied consent still serves ads, just non-personalised ones. -->
  {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
  {adsAllowed && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    />
  )}
</head>
<body>

  <!-- ═══ PWA SPLASH SCREEN (installed-app launches only — hidden for web/search visitors) ═══ -->
  <style>
    #pwa-splash { display: none; }
    @media all and (display-mode: standalone) {
      #pwa-splash { display: flex; }
    }
  </style>
  <AppShell client:load role={role} path={path} initialUser={user} />

  <!-- Mobile drawer overlay -->
  <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
  <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-label="ප්‍රධාන මෙනුව" aria-modal="true" inert>
    <div class="drawer-header">
      <span style="font-family: var(--th-display);font-size:16px;font-weight:700;color:#fff;">වැඩ<span style="color:#0B2A4A;">HUB</span></span>
      <button id="close-drawer" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:22px;cursor:pointer;padding:4px;">✕</button>
    </div>
    <nav aria-label="තවත් විකල්ප">
      {role === 'provider' ? <a href="/jobs" class="drawer-link">වැඩ සොයන්න</a> : <a href="/providers" class="drawer-link">සේවා සොයන්න</a>}
      {role !== 'provider' && <a href="/post-project" class="drawer-link">වැඩක් පළ කරන්න</a>}
      <a href="/my-jobs" class="drawer-link">මගේ වැඩ සහ සමාලෝචන</a>
      {role !== 'provider' && <a href="/join-wedahub" class="drawer-link">සේවා සපයන්නෙකු වන්න</a>}
      <a href="/notifications" class="drawer-link">දැනුම්දීම්</a>
      <div class="drawer-divider"></div>
      <a href="/about" class="drawer-link">වැඩHUB ගැන</a>
      <a href="/contact" class="drawer-link">උදව් සහ සහාය</a>
      <a href="/account" class="drawer-link">මගේ ගිණුම</a>
    </nav>
  </div>

  <!-- Links anonymous drafts/claims to account after sign-in -->
  <DraftLinker client:load />

  <a class="wh-skip" href="#main-content">ප්‍රධාන අන්තර්ගතයට යන්න</a>
  <main class="page-wrap" id="main-content">
    <slot />
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="wh-footer"><span>වැඩHUB · People • Skills • Opportunities</span><nav aria-label="නීතිමය තොරතුරු සහ සහාය"><a href="/contact">උදව්</a><a href="/privacy-policy">පෞද්ගලිකත්වය</a><a href="/terms">කොන්දේසි</a></nav><small>LUXEhome (Pvt) Ltd. විසින් මෙහෙයවනු ලැබේ.</small></footer>

  <script>
    // The menu button lives in the AppShell island, so it asks for the drawer
    // by event rather than reaching across into another React tree.
    const overlay = document.getElementById('drawer-overlay')
    const drawer = document.getElementById('mobile-drawer')
    const closeBtn = document.getElementById('close-drawer')

    function openDrawer() {
      drawer?.removeAttribute('inert')
      drawer?.classList.add('open')
      closeBtn?.focus()
      overlay?.classList.add('open')
      document.body.style.overflow = 'hidden'
    }
    function closeDrawer() {
      drawer?.classList.remove('open')
      drawer?.setAttribute('inert', '')
      overlay?.classList.remove('open')
      document.body.style.overflow = ''
    }

    window.addEventListener('th-drawer-open', openDrawer)
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer() })
    overlay?.addEventListener('click', closeDrawer)
    closeBtn?.addEventListener('click', closeDrawer)
  </script>
  <!-- ═══ COOKIE CONSENT ═══
       Analytics and advertising cookies are denied until this is answered.
       It queues behind the language chooser so a first-time visitor is never
       shown two sheets at once. -->
  <div id="cookie-banner" hidden class="cookie-banner">
    <div class="cookie-banner__text">
      <strong>
        <span class="en-text">අපි කුකීස් භාවිත කරමු</span>
        <span class="si-text">අපි කුකීස් භාවිත කරමු</span>
      </strong>
      <span class="en-text">
        අත්‍යවශ්‍ය කුකීස් ඔබේ පිවිසුම පවත්වාගනී. ඔබේ අවසරයෙන් Google ඇතුළු විශ්ලේෂණ සහ දැන්වීම් කුකීස් භාවිත කර ප්‍රයෝජනවත් දේ හඳුනාගෙන වෙබ් අඩවියේ වියදම් පියවමු. බලන්න: <a href="/privacy-policy">පෞද්ගලිකත්ව ප්‍රතිපත්තිය</a>.
      </span>
      <span class="si-text">
        අත්‍යවශ්‍ය කුකීස් ඔබව පිවිසී තබා ගනී. ඔබේ අවසරය ඇතිව අපි විශ්ලේෂණ සහ දැන්වීම් කුකීස් — Google හි ඒවා ද — භාවිත කරමු.
        වැඩි විස්තර <a href="/privacy-policy">පෞද්ගලිකත්ව ප්‍රතිපත්තියේ</a>.
      </span>
    </div>
    <div class="cookie-banner__actions">
      <button type="button" id="cookie-reject" class="btn btn-outline btn-sm">
        <span class="en-text">අත්‍යවශ්‍ය පමණි</span><span class="si-text">අත්‍යවශ්‍ය පමණි</span>
      </button>
      <button type="button" id="cookie-accept" class="btn btn-terra btn-sm">
        <span class="en-text">සියල්ල පිළිගන්න</span><span class="si-text">සියල්ල පිළිගන්න</span>
      </button>
    </div>
  </div>

  <script is:inline>
    ;(function () {
      var box = document.getElementById('cookie-banner')
      if (!box) return

      function save(choice) {
        try { localStorage.setItem('th_consent', choice) } catch (e) {}
        var granted = choice === 'all'
        if (window.gtag) {
          gtag('consent', 'update', {
            ad_storage: granted ? 'granted' : 'denied',
            ad_user_data: granted ? 'granted' : 'denied',
            ad_personalization: granted ? 'granted' : 'denied',
            analytics_storage: granted ? 'granted' : 'denied',
          })
        }
        // Load GTM either way: with consent denied it sets no cookies, but
        // having it present keeps tag configuration in one place.
        if (window.__thLoadGTM) window.__thLoadGTM()
        box.classList.remove('is-open')
        setTimeout(function () { box.hidden = true }, 260)
      }

      document.getElementById('cookie-accept').addEventListener('click', function () { save('all') })
      document.getElementById('cookie-reject').addEventListener('click', function () { save('essential') })

      window.__thShowConsent = function () {
        box.hidden = false
        requestAnimationFrame(function () { box.classList.add('is-open') })
      }

      var consent = null, lang = null
      try {
        consent = localStorage.getItem('th_consent')
        lang = localStorage.getItem('th_lang')
      } catch (e) { return }
      // A brand-new visitor picks a language first; that flow calls us back.
      if (!consent) window.__thShowConsent()
    })()
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {})
      })
    }
  </script>
</body>
</html>
