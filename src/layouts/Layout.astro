  <script>
    // The menu button lives in the AppShell island, so it asks for the drawer
    // by event rather than reaching across into another React tree.
    const overlay = document.getElementById('drawer-overlay')
    const drawer = document.getElementById('mobile-drawer')
    const closeBtn = document.getElementById('close-drawer')

    function openDrawer() {
      drawer?.classList.add('open')
      overlay?.classList.add('open')
      document.body.style.overflow = 'hidden'
    }
    function closeDrawer() {
      drawer?.classList.remove('open')
      overlay?.classList.remove('open')
      document.body.style.overflow = ''
    }

    window.addEventListener('th-drawer-open', openDrawer)
    overlay?.addEventListener('click', closeDrawer)
    closeBtn?.addEventListener('click', closeDrawer)
  </script>
  <!-- ═══ COOKIE CONSENT ═══
       Analytics and advertising cookies are denied until this is answered.
       It queues behind the language chooser so a first-time visitor is never
       shown two sheets at once. -->
  <div id="cookie-banner" hidden class="cookie-banner">
    <div class="cookie-banner__text">
      <strong>
        <span class="en-text">අපි කුකීස් භාවිත කරමු</span>
        <span class="si-text">අපි කුකීස් භාවිත කරමු</span>
      </strong>
      <span class="en-text">
        අත්‍යවශ්‍ය කුකීස් ඔබේ පිවිසුම පවත්වාගනී. ඔබේ අවසරයෙන් Google ඇතුළු විශ්ලේෂණ සහ දැන්වීම් කුකීස් භාවිත කර ප්‍රයෝජනවත් දේ හඳුනාගෙන වෙබ් අඩවියේ වියදම් පියවමු. බලන්න: <a href="/privacy-policy">පෞද්ගලිකත්ව ප්‍රතිපත්තිය</a>.
