---
import { si as sinhalaText } from '../lib/sinhala.js'
import '../index.css'
import '../styles/theme-2026.css'
import AppShell from '../components/AppShell.jsx'
import DraftLinker from '../components/DraftLinker.jsx'
import { ADSENSE_CLIENT } from '../lib/adsense.js'

const user = Astro.locals.user

// The tab bar is role-dependent, so the role is resolved here rather than in
// the browser: deciding it client-side would mean the first paint shows the
// wrong nav and then swaps. Same rule Dashboard.jsx uses.
let role = 'client'
if (user) {
  const db = Astro.locals.supabase
  const [{ data: provider }, { data: submission }] = await Promise.all([
    db.from('providers').select('id').eq('user_id', user.id).maybeSingle(),
    db.from('provider_submissions').select('status').eq('user_id', user.id).maybeSingle(),
  ])
  if (provider || ['pending_review', 'approved', 'listed'].includes(submission?.status)) {
    role = 'provider'
  }
}

const {
  title = "වැඩHUB · Sri Lanka's Services Marketplace",
  description = "Find tilers, contractors, tile shops, brands and products for your tile and bathroom project across Sri Lanka. Free — no login required.",
  ogImage = 'https://wedahub.lk/og.png',
  ogType = 'website',
  noindex = false,
} = Astro.props
const lang = Astro.locals.lang || 'si'
const path = Astro.url.pathname
const SITE = 'https://wedahub.lk'
const FONT_HREF = 'https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Instrument+Sans:wght@400;500;600&family=Noto+Sans+Sinhala:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap'
const canonicalUrl = `${SITE}${path}`

// Routes that must never carry ads: authentication, account areas, and the
// forms people use to post work or ask for a quote. Auto Ads would otherwise
// inject into all of them, which is both a conversion risk and the kind of
// thin/utility page AdSense policy is unhappy about. The verification meta tag
// still ships everywhere so Google can confirm ownership from any URL.
const AD_FREE_PREFIXES = [
  '/login',
  '/auth',
  '/account',
  '/dashboard',
  '/notifications',
  '/admin',
  '/post-project',
  '/join-wedahub',
  '/contact',
  '/verify-claim',
  '/offline',
]
const adsAllowed = Boolean(ADSENSE_CLIENT)
  && !AD_FREE_PREFIXES.some((p) => path === p || path.startsWith(`${p}/`))

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'වැඩHUB',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
      sameAs: [
        'https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z',
        'https://www.facebook.com/share/g/1Dsc63BvXS/',
      ],
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', areaServed: 'LK' },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'වැඩHUB',
      description: "Sri Lanka's services & home improvement marketplace",
      publisher: { '@id': `${SITE}/#organization` },
      potentialAction: { '@type': 'SearchAction', target: `${SITE}/providers?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
    },
  ],
})
---
<!DOCTYPE html>
<html lang={lang} data-lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{sinhalaText(title)}</title>
  <meta name="description" content={sinhalaText(description)} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="theme-color" content="#F7F7F7" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href="/sitemap.xml" />
  <!-- Open Graph -->
  <meta property="og:title" content={sinhalaText(title)} />
  <meta property="og:description" content={sinhalaText(description)} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="වැඩHUB" />
  <meta property="og:locale" content="si_LK" />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={sinhalaText(title)} />
  <meta name="twitter:description" content={sinhalaText(description)} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Structured data -->
  <script type="application/ld+json" set:html={orgSchema} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <!-- iOS PWA startup images (prevents white flash on launch) -->
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1290x2796.png" media="screen and (device-width:430px) and (device-height:932px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1179x2556.png" media="screen and (device-width:393px) and (device-height:852px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1284x2778.png" media="screen and (device-width:428px) and (device-height:926px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1170x2532.png" media="screen and (device-width:390px) and (device-height:844px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1080x2340.png" media="screen and (device-width:360px) and (device-height:780px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-750x1334.png"  media="screen and (device-width:375px) and (device-height:667px) and (-webkit-device-pixel-ratio:2) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-640x1136.png"  media="screen and (device-width:320px) and (device-height:568px) and (-webkit-device-pixel-ratio:2) and (orientation:portrait)" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="වැඩHUB" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- A CSS @import would be render-blocking and serialised behind the sheet
       that contains it, so the pairing is loaded as a non-blocking link. -->
  <link href={FONT_HREF} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href={FONT_HREF} rel="stylesheet" /></noscript>
  <slot name="head" />
  <style is:global>
    /* Legacy si-text/en-text pairs, from before the trilingual layer. The
       previous rule keyed off "not si", so a Tamil session revealed the
       English span — the leak §9.13 forbids. English now shows only in an
       English session; Tamil falls back to the Sinhala span, because these
       old strings have no Tamil at all yet. New strings go through
       src/lib/i18n.js and are properly trilingual. */
    html[data-lang="en"] .si-text { display: none; }
    html:not([data-lang="en"]) .en-text { display: none; }
  </style>

  <!-- Google Consent Mode v2 defaults, set before any tag can fire. Analytics
       and advertising storage stay denied until the visitor chooses; the
       banner below updates them. Required by Google's EU user consent policy
       and a precondition for serving ads. -->
  <script is:inline>
    ;(function () {
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      window.gtag = gtag

      var saved = null
      try { saved = localStorage.getItem('th_consent') } catch (e) {}
      var granted = saved === 'all'

      gtag('consent', 'default', {
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
        analytics_storage: granted ? 'granted' : 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
      })

      // GTM itself only loads once a choice exists, so a visitor who has not
      // answered never gets an analytics or advertising cookie at all.
      window.__thLoadGTM = function () {
        if (window.__thGTMLoaded) return
        window.__thGTMLoaded = true
        dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        var f = document.getElementsByTagName('script')[0]
        var j = document.createElement('script')
        j.async = true
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-MX727MR5'
        f.parentNode.insertBefore(j, f)
      }
      if (saved) window.__thLoadGTM()
    })()
  </script>

  <!-- Google AdSense. Deliberately after the consent block above: the script
       reads the Consent Mode defaults that block registers, and loading it
       first would let it set an advertising cookie before the visitor has
       answered. Denied consent still serves ads, just non-personalised ones. -->
  {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
  {adsAllowed && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    />
  )}
</head>
<body>

  <!-- ═══ PWA SPLASH SCREEN (installed-app launches only — hidden for web/search visitors) ═══ -->
  <style>
    #pwa-splash { display: none; }
    @media all and (display-mode: standalone) {
      #pwa-splash { display: flex; }
    }
  </style>
  <div id="pwa-splash" style="position:fixed;inset:0;z-index:99999;background:#0B0B0B;flex-direction:column;align-items:center;justify-content:center;gap:20px;transition:opacity 0.45s ease;pointer-events:none;">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:5px;width:78px;height:78px;">
      {[0,1,2,3,4,5,6,7,8].map((i) => (
        <div style={`border-radius:3px;background:${[1,3,4,5,7].includes(i)?'#8B5E3C':'#5E4130'};opacity:${[0,2,6,8].includes(i)?'0.55':'1'};`}></div>
      ))}
    </div>
    <div style="font-family:var(--th-display);font-size:20px;font-weight:700;color:rgba(255,255,255,0.9);letter-spacing:1.5px;">වැඩ<span style="color:#8A6224;">HUB</span></div>
    <div style="width:32px;height:3px;border-radius:2px;background:rgba(255,255,255,0.15);overflow:hidden;margin-top:4px;">
      <div id="pwa-splash-bar" style="height:100%;width:0;background:#8A6224;border-radius:2px;transition:width 1.2s ease;"></div>
    </div>
  </div>
  <script is:inline>
    ;(function() {
      var splash = document.getElementById('pwa-splash')
      var bar    = document.getElementById('pwa-splash-bar')
      if (!splash) return
      // Start progress bar animation immediately
      if (bar) requestAnimationFrame(function() { bar.style.width = '90%' })
      function dismiss() {
        if (!splash || splash._gone) return
        splash._gone = true
        if (bar) bar.style.width = '100%'
        setTimeout(function() {
          splash.style.opacity = '0'
          setTimeout(function() { if (splash.parentNode) splash.parentNode.removeChild(splash) }, 450)
        }, 120)
      }
      window.addEventListener('load', dismiss)
      // Hard cap: always remove after 3 s even if load never fires
      setTimeout(dismiss, 3000)
    })()
  </script>

  <!-- ═══ THE ONE APP BAR + TAB BAR ═══ -->
  <AppShell client:load role={role} path={path} initialUser={user} />

  <!-- Mobile drawer overlay -->
  <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-header">
      <span style="font-family: var(--th-display);font-size:16px;font-weight:700;color:#fff;">වැඩ<span style="color:#8A6224;">HUB</span></span>
      <button id="close-drawer" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:22px;cursor:pointer;padding:4px;">✕</button>
    </div>
    <a href="/" class={`drawer-link${path==='/'?' active':''}`}>🏠 මුල් පිටුව</a>
    <a href="/notifications" class={`drawer-link${path==='/notifications'?' active':''}`}>🔔 දැනුම්දීම්</a>
    <a href="/providers?type=tiler" class={`drawer-link${path.startsWith('/providers')?' active':''}`}>👷 ටයිල් කාර්මිකයන් සොයන්න</a>
    <a href="/jobs" class={`drawer-link${path==='/jobs'?' active':''}`}>💼 ව්‍යාපෘති බලන්න</a>
    <a href="/tile" class={`drawer-link${path==='/tile'?' active':''}`}>🏪 ටයිල් වෙළෙඳසැල් සහ සන්නාම</a>
    <a href="/bathrooms" class={`drawer-link${path==='/bathrooms'?' active':''}`} style="color:rgba(255,255,255,0.6);">🚿 නාන කාමර උපාංග</a>
    <a href="/tools" class={`drawer-link${path==='/tools'?' active':''}`} style="color:rgba(255,255,255,0.6);">🛠️ මෙවලම් සහ උපකරණ</a>
    <div class="drawer-divider"></div>
    {/* One highlighted action, and it is the one for this role. */}
    {role === 'provider'
      ? <a href="/account?tab=quotes" class="drawer-link highlight">📋 මගේ මිල ගණන්</a>
      : <a href="/post-project" class="drawer-link highlight">📋 ව්‍යාපෘතියක් පළ කර මිල ගණන් ලබාගන්න</a>}
    {role !== 'provider' && (
      <a href="/join-wedahub" class="drawer-link" style="color:rgba(255,255,255,0.6);">✅ සේවා සපයන්නෙකු ලෙස එක්වන්න</a>
    )}
    <div class="drawer-divider"></div>
    <a href="https://tilershub.lk/estimator" class={`drawer-link${path==='https://tilershub.lk/estimator'?' active':''}`}>📐 වියදම් ගණකය</a>
    <a href="https://tilershub.lk/guides" class={`drawer-link${path.startsWith('https://tilershub.lk/guides')?' active':''}`} style="color:rgba(255,255,255,0.6);">📖 මඟපෙන්වීම්</a>
    <a href="https://tilershub.lk/blog" class={`drawer-link${path.startsWith('https://tilershub.lk/blog')?' active':''}`} style="color:rgba(255,255,255,0.6);">📰 ලිපි සහ උපදෙස්</a>
    <div class="drawer-divider"></div>
    <a href="/about" class={`drawer-link${path==='/about'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">ℹ️ වැඩHUB ගැන</a>
    <a href="/contact" class={`drawer-link${path==='/contact'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">📬 අප අමතන්න</a>
    <div class="drawer-divider"></div>
    <!-- Language is a set-once preference, so it lives here rather than
         taking a permanent slot in the app bar. -->

  </div>

  <!-- Links anonymous drafts/claims to account after sign-in -->
  <DraftLinker client:load />

  <main class="page-wrap">
    <slot />
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="site-footer">
    <div class="footer-inner">
      <!-- Brand -->
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <div class="site-logo-grid">{[0,1,2,3,4,5,6,7,8].map(()=><div class="site-logo-tile"></div>)}</div>
          <span style="font-family: var(--th-display);font-size:16px;font-weight:700;color:rgba(255,255,255,0.88);">වැඩ<strong>HUB</strong></span>
        </div>
        <p class="footer-brand-text">ශ්‍රී ලංකාවේ ටයිල් ක්ෂේත්‍රයේ එකමුතුව — නිවාස හිමියන් නොමිලේ ව්‍යාපෘති පළ කරයි, කාර්මිකයන් වැඩ ලබාගනී, වෙළෙඳසැල් සහ සැපයුම්කරුවන් දිවයින පුරා පාරිභෝගිකයන් වෙත ළඟාවේ.</p>
        <div style="display:flex;gap:10px;margin-top:16px;">
          <a href="https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#25D366;text-decoration:none;">💬 WhatsApp</a>
          <a href="https://www.facebook.com/share/g/1Dsc63BvXS/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#D4A15E;text-decoration:none;">👥 Facebook</a>
        </div>
      </div>
      <!-- Discover -->
      <div>
        <div class="footer-col-head">ගවේෂණය කරන්න</div>
        <nav class="footer-links">
          <a href="/providers?type=tiler">ටයිල් කාර්මිකයන් සොයන්න</a>
          <a href="/jobs">ව්‍යාපෘති බලන්න</a>
          <a href="https://tilershub.lk/estimator">වියදම් ගණකය</a>
          <a href="/tile">ටයිල් වෙළෙඳසැල් සහ සන්නාම</a>
          <a href="/bathrooms">නාන කාමර උපාංග</a>
          <a href="/tools">මෙවලම් සහ උපකරණ</a>
          <a href="/services/floor-tiling">බිම ටයිල් ඇල්ලීම</a>
        </nav>
      </div>
      <!-- Get Started -->
      <div>
        <div class="footer-col-head">ආරම්භ කරන්න</div>
        <nav class="footer-links">
          <a href="/post-project">ව්‍යාපෘතියක් පළ කරන්න</a>
          <a href="/join-wedahub">සේවා සපයන්නෙකු ලෙස එකතු වන්න</a>
          <a href="/account">මගේ ගිණුම</a>
        </nav>
      </div>
      <!-- Popular Areas -->
      <div>
        <div class="footer-col-head">ජනප්‍රිය ප්‍රදේශ</div>
        <nav class="footer-links">
          <a href="/tilers/colombo">කොළඹ ටයිල් කාර්මිකයන්</a>
          <a href="/tilers/gampaha">ගම්පහ ටයිල් කාර්මිකයන්</a>
          <a href="/tilers/kandy">මහනුවර ටයිල් කාර්මිකයන්</a>
          <a href="/tilers/galle">ගාල්ලේ ටයිල් කාර්මිකයන්</a>
          <a href="/tilers/kurunegala">කුරුණෑගල ටයිල් කාර්මිකයන්</a>
