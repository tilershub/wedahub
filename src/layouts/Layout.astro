  <script is:inline>
    ;(function () {
      var box = document.getElementById('cookie-banner')
      if (!box) return

      function save(choice) {
        try { localStorage.setItem('th_consent', choice) } catch (e) {}
        var granted = choice === 'all'
        if (window.gtag) {
          gtag('consent', 'update', {
            ad_storage: granted ? 'granted' : 'denied',
            ad_user_data: granted ? 'granted' : 'denied',
            ad_personalization: granted ? 'granted' : 'denied',
            analytics_storage: granted ? 'granted' : 'denied',
          })
        }
        // Load GTM either way: with consent denied it sets no cookies, but
        // having it present keeps tag configuration in one place.
        if (window.__thLoadGTM) window.__thLoadGTM()
        box.classList.remove('is-open')
        setTimeout(function () { box.hidden = true }, 260)
      }

      document.getElementById('cookie-accept').addEventListener('click', function () { save('all') })
      document.getElementById('cookie-reject').addEventListener('click', function () { save('essential') })

      window.__thShowConsent = function () {
        box.hidden = false
        requestAnimationFrame(function () { box.classList.add('is-open') })
      }

      var consent = null, lang = null
      try {
        consent = localStorage.getItem('th_consent')
        lang = localStorage.getItem('th_lang')
      } catch (e) { return }
      // A brand-new visitor picks a language first; that flow calls us back.
      if (!consent) window.__thShowConsent()
    })()
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {})
      })
