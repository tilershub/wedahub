---
export const prerender = false
import AdminDashboard from '../components/AdminDashboard.jsx'

const user = Astro.locals.user
if (!user || user.email !== 'tilershub@gmail.com') {
  return Astro.redirect('/login')
}
---
<!DOCTYPE html>
<html lang="si" data-lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>පරිපාලනය · වැඩHUB</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: #F7F3E8; font-family: system-ui, -apple-system, sans-serif; color: #071827; }
    ::-webkit-scrollbar { width: 6px; } ::-webkit-scrollbar-track { background: #F7F3E8; } ::-webkit-scrollbar-thumb { background: #D6D0C6; border-radius: 3px; }
  </style>
</head>
<body>
  <AdminDashboard initialUser={user} client:only="react" />
</body>
</html>
