---
export const prerender = false
import AdminDashboard from '../components/AdminDashboard.jsx'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login?next=%2Fadmin')

// Who counts as an admin lives in the admin_users table — the same table the
// is_admin() RLS policies read — rather than a hardcoded address here. With
// sign-in moving to phone + OTP (§1), an account's email is a synthetic
// 94XXXXXXXXX@phone.wedahub.lk, so a literal address in the source would lock
// the admin out the moment they sign in by phone. Adding a number is now a row,
// not a deploy.
const { data: admin } = await Astro.locals.supabase
  .from('admin_users').select('email').eq('email', user.email).maybeSingle()
if (!admin) return Astro.redirect('/')
---
<!DOCTYPE html>
<html lang="si" data-lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>පරිපාලනය · වැඩHUB</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: #ECECEC; font-family: system-ui, -apple-system, sans-serif; color: #0B0B0B; }
    ::-webkit-scrollbar { width: 6px; } ::-webkit-scrollbar-track { background: #ECECEC; } ::-webkit-scrollbar-thumb { background: #D0D0D0; border-radius: 3px; }
  </style>
</head>
<body>
  <AdminDashboard initialUser={user} client:only="react" />
</body>
</html>
