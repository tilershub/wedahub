---
import { si as sinhalaText } from '../lib/sinhala.js'
import Layout from '../layouts/Layout.astro'

const supabase = Astro.locals.supabase

function waLead(phone, name) {
  const n = (phone || '').replace(/\D/g, '')
  const normalized = n.startsWith('94') ? n : '94' + n.replace(/^0/, '')
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *වැඩHUB* (tilershub.lk) හරහා *${name}* සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *වැඩHUB.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${normalized}?text=${msg}`
}

const { data: toolSuppliers } = await supabase
  .from('providers')
  .select('id,name,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'tool_supplier')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })

const suppliers = toolSuppliers || []

const TOOL_CATEGORIES = [
  { icon: '🔪', name: 'Tile Cutters & Wet Saws', desc: 'Manual tile cutters, wet saws and rail cutters for clean straight cuts.' },
  { icon: '⚙️', name: 'Angle Grinders & Blades', desc: 'Angle grinders with diamond blades for curved cuts and edge finishing.' },
  { icon: '🔩', name: 'Leveling Systems', desc: 'Tile leveling clips, wedges and pliers for perfectly flat installations.' },
  { icon: '🌀', name: 'Mixing Equipment', desc: 'Paddle mixers, buckets and drill attachments for adhesive and grout.' },
  { icon: '🧰', name: 'Trowels & Hand Tools', desc: 'Notched trowels, grout floats, spacers and margin trowels.' },
  { icon: '📏', name: 'Levels & Lasers', desc: 'Spirit levels, laser levels and layout squares for precision work.' },
  { icon: '🧹', name: 'Cleaning & Finishing', desc: 'Grout sponges, tile sealers, cleaning acids and buffing pads.' },
  { icon: '🦺', name: 'Safety Equipment', desc: 'Knee pads, gloves, safety glasses and dust masks for site use.' },
]
---

<Layout
  title="ටයිල් මෙවලම් සහ උපකරණ සැපයුම්කරුවන් · වැඩHUB"
  description="ශ්‍රී ලංකාවේ ටයිල් මෙවලම්, සැපයුම්කරුවන් සහ කුලී සේවා සොයන්න. කැපුම් යන්ත්‍ර, ග්‍රයින්ඩර්, මට්ටම් උපාංග සහ තවත් දේ වැඩHUB හි."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#1a1008,#0B0B0B);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(212,161,94,0.8) 20px,rgba(212,161,94,0.8) 21px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(212,161,94,0.6);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">🔧 මෙවලම් සහ උපකරණ</span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        ටයිල් වැඩ <span style="color:#F59E0B;">මෙවලම්</span> නාමාවලිය
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.45);max-width:460px;margin:0 auto 28px;line-height:1.8;">
        ශ්‍රී ලංකාව පුරා මෙවලම් වෙළෙඳසැල්, උපකරණ සැපයුම්කරුවන් සහ කුලී සේවා සොයන්න. වෘත්තීය ටයිල් කාර්මිකයෙකුට අවශ්‍ය සියල්ල එකම තැනක.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:#F59E0B;color:#0B0B0B;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🔧 ඔබේ මෙවලම් වෙළෙඳසැල එක් කරන්න
        </a>
        <a href="/providers?type=tool_supplier" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          සියලු සැපයුම්කරුවන් බලන්න →
        </a>
      </div>
    </div>
  </div>

  <!-- Tool Categories -->
  <section style="background:var(--surface);padding:52px 20px 56px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:36px;">
        <span class="section-label">ටයිල් කාර්මිකයන්ට අවශ්‍ය දේ</span>
        <h2 style="font-family: var(--th-display);font-size:clamp(22px,3vw,32px);font-weight:700;color:var(--text);margin:8px 0 8px;">මෙවලම් <em style="color:var(--terra);font-style:normal;">කාණ්ඩ</em></h2>
        <p style="font-size:13px;color:var(--text-3);">ලියාපදිංචි සැපයුම්කරුවන්ගෙන් ලබාගත හැකි සියලු උපකරණ කාණ්ඩ</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;">
        {TOOL_CATEGORIES.map(cat => (
          <div style="background:#fff;border-radius:14px;border:1px solid var(--border);padding:20px;display:flex;gap:14px;align-items:flex-start;">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#F2EADC,#E8DCC6);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">{sinhalaText(cat.icon)}</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px;">{sinhalaText(cat.name)}</div>
              <div style="font-size:11px;color:var(--text-3);line-height:1.6;">{sinhalaText(cat.desc)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Suppliers Directory -->
  <section style="background:var(--surface-2);padding:48px 20px 64px;border-top:1px solid var(--border);">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:28px;">
        <div>
          <h2 style="font-family: var(--th-display);font-size:clamp(20px,3vw,28px);font-weight:700;color:var(--text);margin:0 0 4px;">මෙවලම් සැපයුම්කරුවන් සහ කුලියට දෙන වෙළෙඳසැල්</h2>
          <p style="font-size:13px;color:var(--text-3);margin:0;">
            {sinhalaText(suppliers.length > 0 ? `සැපයුම්කරුවන් ${suppliers.length} ක් ලැයිස්තුගත කර ඇත` : 'Be the first to list your tool shop')}
          </p>
        </div>
        <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
          + ඔබේ වෙළෙඳසැල එක් කරන්න
        </a>
      </div>

      {suppliers.length > 0 ? (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px;">
          {suppliers.map(s => (
            <div style="background:#fff;border-radius:16px;border:1px solid var(--border);overflow:hidden;">
              <div style="background:linear-gradient(135deg,#242424,#0B0B0B);padding:16px 18px;display:flex;align-items:center;gap:12px;">
                <div style="width:42px;height:42px;border-radius:11px;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🔧</div>
                <div style="flex:1;min-width:0;">
                  <div style="font-weight:700;font-size:14px;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{sinhalaText(s.name)}</div>
                  <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:1px;">📍 {sinhalaText(s.city)}{sinhalaText(s.district ? `, ${s.district}` : '')}</div>
                </div>
              </div>
              <div style="padding:14px 18px 16px;">
                {s.description && <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:12px;">{sinhalaText(s.description)}</p>}
                {(s.services || []).length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(s.services || []).map(sv => (
                      <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:#F2EADC;color:#242424;border:1px solid #E8DCC6;font-weight:600;">{sinhalaText(sv)}</span>
                    ))}
                  </div>
                )}
                <div style="display:flex;gap:8px;">
                  {s.whatsapp && (
                    <a href={waLead(s.whatsapp, s.name)} target="_blank" rel="noopener noreferrer"
                      style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:8px;font-size:12px;font-weight:700;text-decoration:none;">
                      💬 WhatsApp
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Empty state -->
        <div style="background:#fff;border-radius:20px;border:2px dashed var(--border);padding:56px 24px;text-align:center;max-width:540px;margin:0 auto;">
          <div style="font-size:52px;margin-bottom:16px;">🔧</div>
          <h3 style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:8px;">තවම මෙවලම් සැපයුම්කරුවන් ලැයිස්තුගත කර නැත</h3>
          <p style="font-size:13px;color:var(--text-3);line-height:1.8;margin-bottom:24px;max-width:380px;margin-left:auto;margin-right:auto;">
            ඔබ ටයිල් මෙවලම් අලෙවි කරනවාද හෝ කුලියට දෙනවාද? ශ්‍රී ලංකාව පුරා වෘත්තීය කාර්මිකයන් සිය ගණනක් වෙත ඔබේ වෙළෙඳසැල නොමිලේ ගෙනයන්න.
          </p>
          <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
            🔧 මගේ මෙවලම් වෙළෙඳසැල නොමිලේ එක් කරන්න
          </a>
          <p style="font-size:11px;color:var(--text-4);margin-top:14px;">නොමිලේ ලැයිස්තුගත කිරීම · සෘජු WhatsApp විමසුම් · කොමිස් නැත</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA for tilers -->
  <section style="background:var(--navy);padding:44px 20px;text-align:center;border-top:1px solid rgba(255,255,255,0.06);">
    <div style="max-width:560px;margin:0 auto;">
      <div style="font-size:9px;font-weight:700;color:rgba(212,161,94,0.6);letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;">ටයිල් කාර්මිකයන් සඳහා</div>
      <h2 style="font-family: var(--th-display);font-size:clamp(20px,3.5vw,30px);font-weight:700;color:#fff;margin-bottom:10px;">
        විශේෂ මෙවලමක් සොයනවාද?
      </h2>
      <p style="font-size:13px;color:rgba(255,255,255,0.45);margin-bottom:24px;line-height:1.8;">ඔබට අවශ්‍ය උපකරණ ඇති වැඩපොළ සහ සැපයුම්කරුවන් සොයාගැනීමට ව්‍යාපෘතියක් පළ කරන්න හෝ සේවා සපයන්නන්ගේ ජාලය බලන්න.</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/providers?type=workshop" style="display:inline-flex;align-items:center;gap:7px;background:#F59E0B;color:#0B0B0B;border-radius:11px;padding:11px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🏭 වැඩපොළ බලන්න
        </a>
        <a href="/providers?type=supplier" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:11px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          📦 ද්‍රව්‍ය සැපයුම්කරුවන්
        </a>
      </div>
    </div>
  </section>

</Layout>
