---
import { si as sinhalaText } from '../../lib/sinhala.js'
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { SERVICES } from '../../lib/services.js'
import { DISTRICT_INFO, LOCATION_SERVICE_SLUGS, serviceDistrictPath } from '../../lib/locations.js'
import { LABOUR, typicalCostPerSqft } from '../../lib/costData.js'

const { slug } = Astro.params
const service = SERVICES.find(s => s.slug === slug)
if (!service) return Astro.redirect('/providers')
if (service.externalUrl) return Astro.redirect(service.externalUrl, 302)

const serviceLabel = sinhalaText(service.label)
const supabase = Astro.locals.supabase

const [{ data: providersRaw }, { data: recentProjectsRaw }] = await Promise.all([
  supabase
    .from('providers')
    .select('id,name,city,district,verification_status,slug,services,provider_type,whatsapp,phone,description,profile_image,avg_rating,experience_years,cover_image,daily_rate_min,review_count')
    .eq('status', 'active')
    .limit(200),
  supabase
    .from('projects')
    .select('id,project_type,district,created_at,budget_range,description')
    .eq('status', 'active')
    .ilike('project_type', `%${service.terms[0]}%`)
    .order('created_at', { ascending: false })
    .limit(3),
])

const providers = (providersRaw || []).filter(p =>
  (p.services || []).some(s =>
    service.terms.some(t => String(s).toLowerCase().includes(t.toLowerCase()))
  ) || service.terms.some(t => (p.description || '').toLowerCase().includes(t.toLowerCase()))
).slice(0, 30)

const recentProjects = recentProjectsRaw || []

function timeAgoStr(ts) {
  if (!ts) return ''
  const mins = Math.floor((Date.now() - new Date(ts)) / 60000)
  if (mins < 60) return `${mins}m ago`
  const hrs = Math.floor(mins / 60)
  if (hrs < 24) return `${hrs}h ago`
  const days = Math.floor(hrs / 24)
  return `${days}d ago`
}

function budgetStr(min, max) {
  if (!min && !max) return null
  if (min && max) return `Rs. ${Number(min).toLocaleString()} – ${Number(max).toLocaleString()}`
  if (min) return `රු. ${Number(min).toLocaleString()}`
  return `Up to Rs. ${Number(max).toLocaleString()}`
}

const AVATAR_COLORS = ['#8A6224','#8A6224','#6B4A18','#8A6224','#2F6B4F','#8A6224','#285C43','#8A6224']
function avatarColor(name) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name) {
  return name.split(' ').slice(0,2).map(w => w[0] || '').join('').toUpperCase() || '?'
}
function waLink(phone, name) {
  const cleaned = phone.replace(/\D/g, '')
  const intl = cleaned.startsWith('0') ? '94' + cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi, I found you on වැඩHUB. I'm looking for ${name}.`)}`
}

const pageTitle = `ශ්‍රී ලංකාවේ ${serviceLabel} — සත්‍යාපිත විශේෂඥයන් | වැඩHUB`
const pageDesc = `ශ්‍රී ලංකාව පුරා ${serviceLabel} සඳහා සත්‍යාපිත වෘත්තිකයන් සොයන්න. මිල ගණන් සසඳා, සමාලෝචන කියවා WhatsApp හරහා සෘජුව සම්බන්ධ වන්න. වැඩHUB හි නොමිලේ.`
const postUrl   = `/post-project?type=${encodeURIComponent(service.label)}`
const total     = providers.length

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.label,
  description: pageDesc,
  provider: { '@type': 'Organization', name: 'වැඩHUB', url: 'https://wedahub.lk' },
  areaServed: { '@type': 'Country', name: 'Sri Lanka' },
  url: `https://wedahub.lk/services/${service.slug}`,
})

const hasDistrictPages = LOCATION_SERVICE_SLUGS.includes(service.slug)
const topDistricts = DISTRICT_INFO.filter(d => ['colombo','gampaha','kandy','galle','kurunegala','kalutara','matara','puttalam'].includes(d.slug))
const cost = typicalCostPerSqft()

const SERVICE_FAQS = [
  { q: `ශ්‍රී ලංකාවේ ${serviceLabel} සඳහා වියදම කීයද?`, a: `${serviceLabel} සඳහා ශ්‍රම ගාස්තුව සාමාන්‍යයෙන් වර්ග අඩියකට රු. ${LABOUR.min}–${LABOUR.max} වේ. ද්‍රව්‍ය සමඟ, ටයිල් හෝ සවිකිරීම් මිල හැර වර්ග අඩියකට රු. ${cost.low}–${cost.high} පමණ වැය වේ. අයිතම අනුව ඇස්තමේන්තුවක් සඳහා නොමිලේ වැඩHUB ගණකය භාවිත කරන්න.` },
  { q: `${serviceLabel} සඳහා මිල ගණන් ලබාගන්නේ කෙසේද?`, a: 'ප්‍රදේශයේ ප්‍රමාණය සහ ස්ථානය සමඟ ඔබේ ව්‍යාපෘතිය වැඩHUB හි නොමිලේ පළ කරන්න. සත්‍යාපිත වෘත්තිකයන් WhatsApp වෙත මිල ගණන් එවයි. කොමිස් හෝ අනිවාර්ය බැඳීමකින් තොරව සසඳා තෝරාගන්න.' },
  { q: 'වැඩHUB වෘත්තිකයන් සත්‍යාපිතද?', a: 'සෑම සේවා සපයන්නෙකුගේම අයදුම්පත පැතිකඩ පළ කිරීමට පෙර සමාලෝචනය කෙරේ. අනන්‍යතා පරීක්ෂාව සම්පූර්ණ කළ පැතිකඩවල සත්‍යාපන ලාංඡන පෙන්වයි. පෙර පාරිභෝගිකයන්ගේ සමාලෝචනද පැතිකඩෙහි පෙන්වයි.' },
]

const serviceFaqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SERVICE_FAQS.map(f => ({ '@type': 'Question', name: sinhalaText(f.q), acceptedAnswer: { '@type': 'Answer', text: sinhalaText(f.a) } })),
})
---

<Layout title={sinhalaText(pageTitle)} description={sinhalaText(pageDesc)}>
  <script slot="head" type="application/ld+json" set:html={serviceSchema} />
  <script slot="head" type="application/ld+json" set:html={serviceFaqSchema} />

  <!-- Service header -->
  <div style="background:linear-gradient(135deg,#0B0B0B 0%,#0B0B0B 100%);padding:28px 20px 24px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;">
      <div style="text-align:left;max-width:960px;margin:0 auto;"><Breadcrumbs items={[{ name: 'Services', href: '/categories' }, { name: service.label }]} light /></div>
      <div style="font-size:48px;margin-bottom:10px;">{sinhalaText(service.icon)}</div>
      <h1 style="font-family: var(--th-display);font-size:clamp(20px,4.5vw,30px);font-weight:700;color:#fff;margin:0 0 8px;">{sinhalaText(service.label)}</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.55);margin:0 0 20px;line-height:1.6;">
        ශ්‍රී ලංකාව පුරා සත්‍යාපිත {sinhalaText(service.label)} වෘත්තිකයන් සොයන්න
      </p>
      <a href={postUrl}
        style="display:inline-flex;align-items:center;gap:8px;background:#8A6224;color:#fff;border-radius:24px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(212,161,94,0.4);">
        📋 {sinhalaText(service.label)} ව්‍යාපෘතියක් පළ කරන්න
      </a>
    </div>
  </div>

  <!-- Provider list -->
  <div style="background:#F7F7F7;min-height:300px;padding:20px 16px 80px;">

    {total === 0 ? (

      <div style="text-align:center;padding:48px 20px;">
        <div style="font-size:40px;margin-bottom:12px;">{sinhalaText(service.icon)}</div>
        <h2 style="font-family: var(--th-display);font-size:18px;font-weight:700;color:#0B0B0B;margin:0 0 8px;">තවම සේවා සපයන්නන් ලැයිස්තුගත කර නැත</h2>
        <p style="font-size:13px;color:#6E6E6E;margin:0 0 20px;line-height:1.7;">
          පළමු සේවා සපයන්නා ලෙස එක්වන්න — {sinhalaText(service.label)} සඳහා වැඩHUB හි ලියාපදිංචි වන්න. නැතිනම් ලංසු ලබාගැනීමට ව්‍යාපෘතියක් පළ කරන්න.
        </p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
          <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:6px;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            ✅ සේවා සපයන්නෙකු ලෙස එක්වන්න
          </a>
          <a href={postUrl} style="display:inline-flex;align-items:center;gap:6px;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            📋 ව්‍යාපෘතියක් පළ කරන්න
          </a>
        </div>
      </div>

    ) : (

      <div style="max-width:960px;margin:0 auto;">

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <span style="font-size:13px;font-weight:700;color:#4A4A4A;">{sinhalaText(total)} සේවා සපයන්නා{sinhalaText(total !== 1 ? 's' : '')} හමු විය</span>
          <a href="/providers" style="font-size:12px;color:#8A6224;font-weight:600;text-decoration:none;">සියල්ල බලන්න ›</a>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
        {providers.map(p => {
          const color = avatarColor(p.name || 'P')
          const inits = initials(p.name || 'P')
          const phone = p.whatsapp || p.phone
          const isVerified = ['th_master','th_certified_pro','th_verified'].includes(p.verification_status)
          const coverSrc = p.cover_image || p.profile_image
          const cardHref = p.slug ? `/providers/${p.slug}` : null
          return (
            <div onclick={cardHref ? `location.href='${cardHref}'` : undefined} style={`display:flex;flex-direction:column;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.08);${cardHref ? 'cursor:pointer;' : ''}`}>
              <div style="position:relative;height:200px;flex-shrink:0;">
                {coverSrc
                  ? <img src={coverSrc} alt={sinhalaText(p.name)} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                  : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                      <span style="font-size:48px;font-weight:800;color:rgba(255,255,255,0.85);">{sinhalaText(inits)}</span>
                    </div>
                }
                {isVerified && (
                  <span style="position:absolute;top:10px;right:10px;background:#2F6B4F;color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:3px 9px;">✓ සත්‍යාපිත</span>
                )}
              </div>
              <div style="padding:14px 16px;display:flex;flex-direction:column;flex:1;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px;">
                  <span style="font-size:16px;font-weight:700;color:#0B0B0B;line-height:1.25;">{sinhalaText(p.name)}</span>
                  {p.daily_rate_min && (
                    <span style="font-size:12px;font-weight:700;color:#8A6224;white-space:nowrap;flex-shrink:0;">රු. {sinhalaText(Number(p.daily_rate_min).toLocaleString())}දිනකට</span>
                  )}
                </div>
                <div style="font-size:12px;margin-bottom:8px;">
                  {p.avg_rating > 0
                    ? <span style="color:#f59e0b;">⭐ {sinhalaText(Number(p.avg_rating).toFixed(1))}{sinhalaText(p.review_count ? ` (සමාලෝචන ${p.review_count})` : '')}</span>
                    : <span style="color:#8C8C8C;">අලුත් · තවම සමාලෝචන නැත</span>
                  }
                </div>
                {p.description && (
                  <div style="font-size:12px;color:#6E6E6E;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.5;">{sinhalaText(p.description)}</div>
                )}
                <div style="border-top:1px solid #ECECEC;margin-top:auto;padding-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                  {p.experience_years > 0 && (
                    <span style="font-size:11px;font-weight:600;color:#2F6B4F;">🛡 {sinhalaText(p.experience_years)}+ වසර</span>
                  )}
                  {(p.city || p.district) && (
                    <span style="font-size:11px;color:#6E6E6E;">📍 {sinhalaText(p.city || p.district)}</span>
                  )}
                  <div style="margin-left:auto;display:flex;gap:6px;">
                    {phone && (
                      <a href={waLink(phone, p.name)} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()"
                        style="display:inline-flex;align-items:center;gap:4px;background:#25D366;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">
                        💬
                      </a>
                    )}
                    {cardHref && (
                      <a href={cardHref} onclick="event.stopPropagation()"
                        style="display:inline-flex;align-items:center;gap:4px;background:#8A6224;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">
                        බලන්න ›
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )
        })}
        </div>

      </div>
    )}
  </div>

  <!-- Recent Projects on this service -->
  {recentProjects.length > 0 && (
    <div style="background:#fff;padding:28px 16px 32px;border-top:1px solid #ECECEC;">
      <div style="max-width:640px;margin:0 auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-family: var(--th-display);font-size:18px;font-weight:700;color:#0B0B0B;margin:0;">
            <span class="en-text">මෑත ව්‍යාපෘති</span>
            <span class="si-text">මෑත ව්‍යාපෘති</span>
          </h2>
          <a href="/jobs" style="font-size:12px;color:#8A6224;font-weight:600;text-decoration:none;">
            <span class="en-text">සියල්ල බලන්න ›</span>
            <span class="si-text">සියල්ල බලන්න ›</span>
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {recentProjects.map(proj => {
            const budget = proj.budget_range || null
            return (
              <div style="background:#F7F7F7;border:1px solid #E2E2E2;border-radius:14px;padding:14px 16px;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:6px;">
                  <span style="font-size:13px;font-weight:700;color:#0B0B0B;">{sinhalaText(proj.project_type)}</span>
                  <span style="font-size:10px;color:#8C8C8C;white-space:nowrap;flex-shrink:0;">{sinhalaText(timeAgoStr(proj.created_at))}</span>
                </div>
                {proj.district && <div style="font-size:11px;color:#6E6E6E;margin-bottom:4px;">📍 {sinhalaText(proj.district)}</div>}
                {proj.description && <p style="font-size:12px;color:#6E6E6E;margin:0 0 6px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(proj.description)}</p>}
                {budget && <div style="font-size:11px;font-weight:600;color:#4A4A4A;">💰 {sinhalaText(budget)}</div>}
              </div>
            )
          })}
        </div>
      </div>
    </div>
  )}

  <!-- FAQ + district links -->
  <div style="background:#F7F7F7;padding:28px 16px 36px;border-top:1px solid #ECECEC;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:20px;">
      <div>
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0 0 12px;">{sinhalaText(service.label)} — නිතර අසන ප්‍රශ්න</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {SERVICE_FAQS.map(f => (
            <details style="background:#fff;border:1px solid #E2E2E2;border-radius:12px;padding:14px 16px;">
              <summary style="font-size:13px;font-weight:700;color:#0B0B0B;cursor:pointer;">{sinhalaText(f.q)}</summary>
              <p style="font-size:13px;color:#4A4A4A;line-height:1.8;margin:10px 0 0;">{sinhalaText(f.a)}</p>
            </details>
          ))}
        </div>
      </div>
      {hasDistrictPages && (
        <div>
          <h2 style="font-size:14px;font-weight:800;color:#0B0B0B;margin:0 0 10px;">{sinhalaText(service.label)} දිස්ත්‍රික්කය අනුව</h2>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {topDistricts.map(d => (
              <a href={serviceDistrictPath(service.slug, d)} style="font-size:12px;font-weight:700;color:#8A6224;background:#fff;border:1px solid #E8DCC6;border-radius:20px;padding:7px 14px;text-decoration:none;">{sinhalaText(service.label)} in {sinhalaText(d.name)}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Post Project CTA -->
  <div style="background:linear-gradient(135deg,#0B0B0B 0%,#0B0B0B 100%);padding:40px 20px;text-align:center;">
    <h2 style="font-family: var(--th-display);font-size:clamp(18px,4vw,24px);font-weight:700;color:#fff;margin:0 0 10px;">
      <span class="en-text">Need {sinhalaText(service.label)} done?</span>
      <span class="si-text">{sinhalaText(service.label)} සේවාවක් අවශ්‍යද?</span>
    </h2>
    <p style="font-size:14px;color:rgba(255,255,255,0.65);margin:0 0 22px;line-height:1.7;">
      <span class="en-text">ඔබේ ව්‍යාපෘතිය නොමිලේ පළ කර සත්‍යාපිත විශේෂඥයන්ගෙන් මිල ගණන් ලබාගන්න</span>
      <span class="si-text">ඔබේ ව්‍යාපෘතිය නොමිලේ පළ කර සත්‍යාපිත ශිල්පීන්ගේ ලංසු ලබා ගන්න</span>
    </p>
    <a href={postUrl}
      style="display:inline-flex;align-items:center;gap:8px;background:#8A6224;color:#fff;border-radius:24px;padding:13px 28px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(212,161,94,0.45);">
      📋
      <span class="en-text">ඔබේ ව්‍යාපෘතිය පළ කරන්න →</span>
      <span class="si-text">ව්‍යාපෘතිය පලකරන්න →</span>
    </a>
  </div>

</Layout>
