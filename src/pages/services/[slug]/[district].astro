---
import { si as sinhalaText } from '../../../lib/sinhala.js'
// /services/<service>/<district> — programmatic SEO landing page,
// e.g. /services/floor-tiling/colombo. Only LOCATION_SERVICE_SLUGS ×
// DISTRICT_INFO combinations render; anything else redirects.
export const prerender = false
import Layout from '../../../layouts/Layout.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import { SERVICES } from '../../../lib/services.js'
import { districtBySlug, districtPath, serviceDistrictPath, neighborDistricts, LOCATION_SERVICE_SLUGS } from '../../../lib/locations.js'
import { LABOUR, ADHESIVE_TIERS, EXTRAS, typicalCostPerSqft } from '../../../lib/costData.js'
import { jobPath, timeAgo } from '../../../lib/jobs.js'

const { slug, district: districtSlug } = Astro.params
const service = SERVICES.find(s => s.slug === slug)
const district = districtBySlug(districtSlug)

if (!service) return Astro.redirect('/providers', 302)
if (!district || !LOCATION_SERVICE_SLUGS.includes(service.slug)) return Astro.redirect(`/services/${service.slug}`, 302)

const serviceLabel = sinhalaText(service.label)
const supabase = Astro.locals.supabase

const [{ data: providersRaw }, { data: jobsRaw }] = await Promise.all([
  supabase
    .from('providers')
    .select('id,name,city,district,verification_status,slug,services,whatsapp,phone,description,profile_image,avg_rating,experience_years,cover_image,daily_rate_min,review_count,service_areas')
    .eq('status', 'active')
    .limit(200),
  supabase
    .from('projects')
    .select('id,project_type,city,district,created_at,description')
    .eq('status', 'active')
    .eq('district', district.name)
    .ilike('project_type', `%${service.terms[0]}%`)
    .order('created_at', { ascending: false })
    .limit(4),
])

const inDistrict = p =>
  p.district === district.name ||
  (p.service_areas || []).includes(district.name) ||
  (p.city || '').toLowerCase().includes(district.name.toLowerCase())

const matchesService = p =>
  (p.services || []).some(s => service.terms.some(t => String(s).toLowerCase().includes(t.toLowerCase()))) ||
  service.terms.some(t => (p.description || '').toLowerCase().includes(t.toLowerCase()))

const providers = (providersRaw || []).filter(p => inDistrict(p) && matchesService(p)).slice(0, 18)
const jobs = jobsRaw || []
const total = providers.length
const neighbors = neighborDistricts(district.slug)
// These pages are generated for every district (and every district × service
// pair), but the directory only fills them once real providers cover that
// area. An empty template is thin content: keep it reachable, keep it out of
// the index, and let it back in automatically once it has something to show.
const isThin = providers.length === 0 && jobs.length === 0
const cost = typicalCostPerSqft()
const year = new Date().getFullYear()
const districtLabel = district.nameSi || sinhalaText(district.name)
const townLabels = district.towns.map(sinhalaText)

const AVATAR_COLORS = ['#8A6224','#8A6224','#6B4A18','#8A6224','#2F6B4F','#8A6224','#285C43','#8A6224']
function avatarColor(name) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name) {
  return name.split(' ').slice(0, 2).map(w => w[0] || '').join('').toUpperCase() || '?'
}
function waLink(phone) {
  const cleaned = phone.replace(/\D/g, '')
  const intl = cleaned.startsWith('0') ? '94' + cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi, I found you on වැඩHUB. I need ${service.label} in ${district.name}.`)}`
}

const SITE = 'https://wedahub.lk'
const pageUrl = `${SITE}${serviceDistrictPath(service.slug, district)}`
const pageTitle = `${districtLabel} හි ${serviceLabel} — ගාස්තු සහ සත්‍යාපිත වෘත්තිකයන් (${year}) | වැඩHUB`
const pageDesc = `${districtLabel} හි ${serviceLabel} සඳහා සත්‍යාපිත වෘත්තිකයන් සොයාගන්න. ${year} ශ්‍රම ගාස්තු වර්ග අඩියකට රු. ${LABOUR.min} සිට. වැඩHUB හරහා නොමිලේ WhatsApp මිල ගණන් සසඳන්න.`

const FAQS = [
  { q: `${districtLabel} හි ${serviceLabel} සඳහා වියදම කීයද?`, a: `${districtLabel} හි ${serviceLabel} ශ්‍රම ගාස්තුව සාමාන්‍යයෙන් වර්ග අඩියකට රු. ${LABOUR.min}–${LABOUR.max} වේ. ඇලවුම් ද්‍රව්‍ය රු. ${ADHESIVE_TIERS[0].rate}–${ADHESIVE_TIERS[2].rate} සහ ග්‍රවුට් රු. ${EXTRAS.grout} බැගින් එක් කළ විට ටයිල් මිල හැර වර්ග අඩියකට රු. ${cost.low}–${cost.high} පමණ වේ. විස්තරාත්මක ඇස්තමේන්තුවක් සඳහා නොමිලේ වැඩHUB ගණකය භාවිත කරන්න.` },
  { q: `${districtLabel} හි ${serviceLabel} වෘත්තිකයෙකු සම්බන්ධ කරගන්නේ කෙසේද?`, a: `ඔබේ ව්‍යාපෘතිය වැඩHUB හි නොමිලේ පළ කරන්න. ${townLabels.slice(0,3).join(', ')} සහ ${districtLabel} දිස්ත්‍රික්කයේ අනෙකුත් ප්‍රදේශවල සත්‍යාපිත වෘත්තිකයන් ඔබේ WhatsApp වෙත මිල ගණන් එවනු ඇත. කොමිස් හෝ අනිවාර්ය බැඳීමක් නැත.` },
  { q: `${districtLabel} හි කුමන නගරවල සේවය ලැබේද?`, a: `වැඩHUB සේවා සපයන්නන් ${townLabels.join(', ')} සහ ${districtLabel} දිස්ත්‍රික්කයේ අවට ප්‍රදේශවල සේවය සපයයි.` },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(f => ({ '@type': 'Question', name: sinhalaText(f.q), acceptedAnswer: { '@type': 'Answer', text: sinhalaText(f.a) } })),
})

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.label} in ${district.name}`,
  description: pageDesc,
  provider: { '@type': 'Organization', name: 'වැඩHUB', url: SITE },
  areaServed: { '@type': 'AdministrativeArea', name: `${district.name} District, Sri Lanka` },
  url: pageUrl,
})

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=600')
---

<Layout title={sinhalaText(pageTitle)} description={sinhalaText(pageDesc)} noindex={isThin}>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <script slot="head" type="application/ld+json" set:html={serviceSchema} />

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#0B0B0B 0%,#0B0B0B 100%);padding:30px 20px 28px;position:relative;overflow:hidden;">
    <div style="position:relative;max-width:960px;margin:0 auto;">
      <Breadcrumbs items={[{ name: service.label, href: `/services/${service.slug}` }, { name: district.name }]} light />
      <div style="font-size:40px;margin-bottom:8px;">{sinhalaText(service.icon)}</div>
      <h1 style="font-family: var(--th-display);font-size:clamp(21px,4.5vw,30px);font-weight:700;color:#fff;margin:0 0 8px;">
        {sinhalaText(district.name)} හි {sinhalaText(service.label)}
      </h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0 0 18px;line-height:1.7;max-width:620px;">
        සත්‍යාපිත {serviceLabel} වෘත්තිකයන් සේවය සපයන ප්‍රදේශ: {sinhalaText(townLabels.slice(0, 4).join(', '))} සහ මුළු {sinhalaText(district.name)} දිස්ත්‍රික්කය. ශ්‍රම ගාස්තුව රු. {sinhalaText(LABOUR.min)}/වර්ග අඩි සිට · WhatsApp මිල ගණන් නොමිලේ.
      </p>
      <a href={`/post-project?type=${encodeURIComponent(service.label)}&district=${encodeURIComponent(district.name)}`}
        style="display:inline-flex;align-items:center;gap:8px;background:#8A6224;color:#fff;border-radius:24px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(212,161,94,0.4);">
        📋 {sinhalaText(service.label)} ව්‍යාපෘතියක් පළ කරන්න
      </a>
    </div>
  </div>

  <!-- Providers -->
  <div style="background:#F7F7F7;padding:24px 16px 36px;">
    <div style="max-width:960px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0;">{sinhalaText(total > 0 ? `${districtLabel} හි ${serviceLabel} වෘත්තිකයන් ${total}` : `${districtLabel} අසල ${serviceLabel} වෘත්තිකයන්`)}</h2>
        <a href={`/services/${service.slug}`} style="font-size:12px;color:#8A6224;font-weight:600;text-decoration:none;">සියල්ල {sinhalaText(service.label)} ›</a>
      </div>

      {total === 0 ? (
        <div style="text-align:center;padding:32px 20px;background:#fff;border-radius:16px;border:1px solid #E2E2E2;">
          <div style="font-size:36px;margin-bottom:10px;">{sinhalaText(service.icon)}</div>
          <p style="font-size:13px;color:#6E6E6E;margin:0 0 16px;line-height:1.7;">
            No {serviceLabel} වෘත්තිකයන් ලැයිස්තුගත වී නැති ප්‍රදේශය: {sinhalaText(district.name)} — ඔබේ ව්‍යාපෘතිය පළ කරන්න. අසල වෘත්තිකයන් ලංසු එවනු ඇත.
          </p>
          <a href={`/post-project?type=${encodeURIComponent(service.label)}`} style="display:inline-flex;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">📋 ව්‍යාපෘතියක් පළ කරන්න</a>
        </div>
      ) : (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
          {providers.map(p => {
            const color = avatarColor(p.name || 'P')
            const inits = initials(p.name || 'P')
            const phone = p.whatsapp || p.phone
            const isVerified = ['th_master','th_certified_pro','th_verified'].includes(p.verification_status)
            const coverSrc = p.cover_image || p.profile_image
            const cardHref = p.slug ? `/providers/${p.slug}` : null
            return (
              <div onclick={cardHref ? `location.href='${cardHref}'` : undefined} style={`display:flex;flex-direction:column;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.08);${cardHref ? 'cursor:pointer;' : ''}`}>
                <div style="position:relative;height:150px;flex-shrink:0;">
                  {coverSrc
                    ? <img src={coverSrc} alt={sinhalaText(`${p.name} — ${sinhalaText(district.name)} හි ${sinhalaText(service.label)}`)} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                        <span style="font-size:40px;font-weight:800;color:rgba(255,255,255,0.85);">{sinhalaText(inits)}</span>
                      </div>
                  }
                  {isVerified && (
                    <span style="position:absolute;top:10px;right:10px;background:#2F6B4F;color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:3px 9px;">✓ සත්‍යාපිත</span>
                  )}
                </div>
                <div style="padding:14px 16px;display:flex;flex-direction:column;flex:1;">
                  <span style="font-size:15px;font-weight:700;color:#0B0B0B;line-height:1.25;margin-bottom:5px;">{sinhalaText(p.name)}</span>
                  <div style="font-size:12px;margin-bottom:8px;">
                    {p.avg_rating > 0
                      ? <span style="color:#f59e0b;">⭐ {sinhalaText(Number(p.avg_rating).toFixed(1))}{sinhalaText(p.review_count ? ` (${p.review_count})` : '')}</span>
                      : <span style="color:#8C8C8C;">අලුත් · තවම සමාලෝචන නැත</span>
                    }
                  </div>
                  <div style="border-top:1px solid #ECECEC;margin-top:auto;padding-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    {p.experience_years > 0 && <span style="font-size:11px;font-weight:600;color:#2F6B4F;">🛡 {sinhalaText(p.experience_years)}+ වසර</span>}
                    <span style="font-size:11px;color:#6E6E6E;">📍 {sinhalaText(p.city || p.district)}</span>
                    <div style="margin-left:auto;display:flex;gap:6px;">
                      {phone && (
                        <a href={waLink(phone)} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()"
                          style="display:inline-flex;background:#25D366;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">💬</a>
                      )}
                      {cardHref && (
                        <a href={cardHref} onclick="event.stopPropagation()"
                          style="display:inline-flex;background:#8A6224;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">බලන්න ›</a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Recent matching jobs -->
  {jobs.length > 0 && (
    <div style="background:#fff;padding:24px 16px;border-top:1px solid #ECECEC;">
      <div style="max-width:720px;margin:0 auto;">
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0 0 12px;">මෑත {serviceLabel} ව්‍යාපෘති — {sinhalaText(district.name)}</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {jobs.map(j => (
            <a href={jobPath(j)} style="display:block;background:#F7F7F7;border:1px solid #E2E2E2;border-radius:14px;padding:14px 16px;text-decoration:none;color:inherit;">
              <div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:4px;">
                <span style="font-size:13px;font-weight:700;color:#0B0B0B;">{sinhalaText(j.project_type)}</span>
                <span style="font-size:10px;color:#8C8C8C;white-space:nowrap;">{sinhalaText(timeAgo(j.created_at))}</span>
              </div>
              {j.description && <p style="font-size:12px;color:#6E6E6E;margin:0;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(j.description)}</p>}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Cost + FAQ + cross links -->
  <div style="background:#F7F7F7;padding:28px 16px 40px;border-top:1px solid #ECECEC;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:22px;">

      <div>
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0 0 8px;">{sinhalaText(service.label)} ගාස්තු — {sinhalaText(district.name)} ({sinhalaText(year)})</h2>
        <p style="font-size:13px;color:#4A4A4A;line-height:1.9;margin:0 0 12px;">
          ශ්‍රම ගාස්තුව <strong>රු. {sinhalaText(LABOUR.min)}–{sinhalaText(LABOUR.max)}/වර්ග අඩි</strong>; ඇලවුම් ද්‍රව්‍ය, ග්‍රවුට් සහ ක්ලිප් සමඟ ආසන්න වශයෙන්
          <strong> රු. {sinhalaText(cost.low)}–{sinhalaText(cost.high)}/වර්ග අඩි</strong> ද්‍රව්‍යවලට පෙර. නොමිලේ ගණකයෙන් විස්තරාත්මක ඇස්තමේන්තුවක් ගන්න.
        </p>
        <a href="https://tilershub.lk/estimator" style="display:inline-flex;align-items:center;gap:7px;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">📐 ටයිල් වියදම් ගණකය →</a>
      </div>

      <div>
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0 0 12px;">නිතර අසන ප්‍රශ්න</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {FAQS.map(f => (
            <details style="background:#fff;border:1px solid #E2E2E2;border-radius:12px;padding:14px 16px;">
              <summary style="font-size:13px;font-weight:700;color:#0B0B0B;cursor:pointer;">{sinhalaText(f.q)}</summary>
              <p style="font-size:13px;color:#4A4A4A;line-height:1.8;margin:10px 0 0;">{sinhalaText(f.a)}</p>
            </details>
          ))}
        </div>
      </div>

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0B0B0B;margin:0 0 10px;">{sinhalaText(service.label)} — අසල දිස්ත්‍රික්කවල</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {neighbors.map(n => (
            <a href={serviceDistrictPath(service.slug, n)} style="font-size:12px;font-weight:700;color:#4A4A4A;background:#fff;border:1px solid #E2E2E2;border-radius:20px;padding:7px 14px;text-decoration:none;">{sinhalaText(service.label)} in {sinhalaText(n.name)}</a>
          ))}
          <a href={districtPath(district)} style="font-size:12px;font-weight:700;color:#8A6224;background:#F5EEE2;border:1px solid #E8DCC6;border-radius:20px;padding:7px 14px;text-decoration:none;">{sinhalaText(district.name)} හි සියලු ටයිල් කාර්මිකයන්</a>
        </div>
      </div>

    </div>
  </div>

</Layout>
