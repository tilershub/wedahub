---
import Layout from '../../../layouts/Layout.astro'
import PageIntro from '../../../components/PageIntro.astro'
import ProviderDirectory from '../../../components/ProviderDirectory.jsx'
import { SERVICES } from '../../../lib/services.js'
import { districtBySlug } from '../../../lib/locations.js'
const service = SERVICES.find(s => s.slug === Astro.params.slug)
const district = districtBySlug(Astro.params.district)
if (!service || !district) return Astro.rewrite('/404')
---
<Layout title={`${service.label} · ${district.name} · වැඩHUB`} description={`Find ${service.label.toLowerCase()} providers serving ${district.name}.`}><div class="wh-container"><PageIntro title={`${service.si || service.label} · ${district.name}`} subtitle="ඔබ අසල සේවා සපයන්නන් සමඟ සම්බන්ධ වන්න."/><ProviderDirectory client:load initialSearch={service.terms[0]} initialDistrict={district.name}/></div></Layout>
