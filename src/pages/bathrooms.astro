---
import { si as sinhalaText } from '../lib/sinhala.js'
import Layout from '../layouts/Layout.astro'
import BathroomShopsGrid from '../components/BathroomShopsGrid.jsx'

const supabase = Astro.locals.supabase

const { data: shopData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'bathroom_shop')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })
const shops = shopData || []

const { data: contractorData } = await supabase
  .from('providers')
  .select('id,name,slug,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'contractor')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })
const contractors = contractorData || []

const { data: allBrands } = await supabase
  .from('brands').select('*').eq('status', 'active')
  .order('is_featured', { ascending: false }).order('name')
const brands = allBrands || []

const BATHROOM_CATS     = ['Sanitary Ware', 'Faucets', 'Bathroom Fittings', 'Bathroom Products', 'Showers', 'Bathtubs', 'Bathroom Accessories']
const WATERPROOF_CATS   = ['Waterproofing', 'Sealants', 'Pipe Fittings', 'Plumbing']
const RENO_CATS         = ['Bathroom Renovation', 'Interior Design', 'Construction', 'Premium Partner']

const isBathroom    = (b) => (b.categories || []).some(c => BATHROOM_CATS.includes(c))
const isWaterproof  = (b) => (b.categories || []).some(c => WATERPROOF_CATS.includes(c))
const isReno        = (b) => (b.categories || []).some(c => RENO_CATS.includes(c))

const bathroomBrands     = brands.filter(b => isBathroom(b))
const waterproofBrands   = brands.filter(b => isWaterproof(b) && !isBathroom(b))
const renoBrands         = brands.filter(b => isReno(b) && !isBathroom(b) && !isWaterproof(b))

const BRAND_META = {
  'rocell':      { color: '#FFFFFF', bg: '#002B5B' },
  'lanka-tile':  { color: '#FFFFFF', bg: '#CC2229' },
  'macktiles':   { color: '#FFFFFF', bg: '#2F6B4F' },
  'megatile':    { color: '#FFFFFF', bg: '#4A4A4A' },
  'swisstek':    { color: '#FFFFFF', bg: '#1565C0' },
  'tokyo-super': { color: '#FFFFFF', bg: '#C0392B' },
  'dr-fixit':    { color: '#FFFFFF', bg: '#8A6224' },
  'sika':        { color: '#FFFFFF', bg: '#B71C1C' },
  'finex':       { color: '#FFFFFF', bg: '#1A237E' },
}
function meta(brand) { return BRAND_META[brand.slug] || { color: '#fff', bg: '#8A6224' } }
function logoText(name) { return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() }

const PRODUCT_CATEGORIES = [
  { icon: '🚽', name: 'Sanitary Ware',       desc: 'Toilets, basins, bidets and urinals from leading brands.' },
  { icon: '🚿', name: 'Showers & Enclosures', desc: 'Rain showers, handheld showers, shower screens and enclosures.' },
  { icon: '🛁', name: 'Bathtubs',             desc: 'Freestanding, built-in and corner bathtubs for every bathroom size.' },
  { icon: '🔩', name: 'Faucets & Mixers',     desc: 'Basin mixers, bath mixers, kitchen taps and deck-mounted faucets.' },
  { icon: '🪞', name: 'Mirrors & Cabinets',   desc: 'Bathroom mirrors, vanity units and storage cabinets.' },
  { icon: '🧻', name: 'Accessories & Rails',  desc: 'Towel rails, toilet paper holders, soap dispensers and hooks.' },
  { icon: '💡', name: 'Bathroom Lighting',    desc: 'IP-rated ceiling lights, mirror lights and downlights.' },
  { icon: '🪣', name: 'Waterproofing & Drainage', desc: 'Floor traps, linear drains, waterproof membranes and seals.' },
]
import { brandHref, sponsorPage } from '../lib/sponsors.js'
---

<Layout
  title="ශ්‍රී ලංකාවේ නාන කාමර නිෂ්පාදන, සන්නාම සහ වෙළෙඳසැල් · වැඩHUB"
  description="වැඩHUB හි ශ්‍රී ලංකාවේ නාන කාමර වෙළෙඳසැල්, සනීපාරක්ෂක සන්නාම, කරාම, ෂවර් සහ උපාංග සොයන්න."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#0B0B0B,#8A6224);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:700px;height:400px;background:radial-gradient(ellipse,rgba(255,255,255,0.04) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(212,161,94,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">🚿 නාන කාමර</span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        නාන කාමරය <span style="color:var(--terra);">නිෂ්පාදන සහ සවිකිරීම්</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto 28px;line-height:1.8;">
        ශ්‍රී ලංකාව පුරා නාන කාමර ප්‍රදර්ශනාගාර, සනීපාරක්ෂක සන්නාම, ජලරෝධන ද්‍රව්‍ය, කරාම සහ අලුත්වැඩියා කොන්ත්‍රාත්කරුවන් සොයන්න.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:#8A6224;color:#fff;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🚿 ඔබේ වෙළෙඳසැල ලැයිස්තුගත කරන්න
        </a>
        <a href="/post-project" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          📋 ව්‍යාපෘතියක් පළ කරන්න →
        </a>
      </div>
    </div>
  </div>

  <!-- Product Categories -->
  <section style="background:var(--surface);padding:52px 20px 56px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:36px;">
        <span class="section-label">ඔබට හමුවන දේ</span>
        <h2 style="font-family: var(--th-display);font-size:clamp(22px,3vw,32px);font-weight:700;color:var(--text);margin:8px 0 8px;">නිෂ්පාදන <em style="color:var(--terra);font-style:normal;">කාණ්ඩ</em></h2>
        <p style="font-size:13px;color:var(--text-3);">ලියාපදිංචි වෙළෙඳසැල්වල ඇති සියලු නාන කාමර නිෂ්පාදන කාණ්ඩ</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;">
        {PRODUCT_CATEGORIES.map(cat => (
          <div style="background:#fff;border-radius:14px;border:1px solid var(--border);padding:20px;display:flex;gap:14px;align-items:flex-start;">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#F5EEE2,#F2EADC);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">{sinhalaText(cat.icon)}</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px;">{sinhalaText(cat.name)}</div>
              <div style="font-size:11px;color:var(--text-3);line-height:1.6;">{sinhalaText(cat.desc)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bathroom Brands -->
  {bathroomBrands.length > 0 && (
    <section style="background:var(--surface-2);padding:52px 0 56px;border-top:1px solid var(--border);">
      <div style="max-width:1100px;margin:0 auto;padding:0 20px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#0B0B0B,#8A6224);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🚿</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">නාන කාමර සන්නාම</div>
              <div style="font-size:12px;color:var(--text-4);">සනීපාරක්ෂක උපකරණ, කරාම, ෂවර්, නාන බේසම් සහ නානකාමර උපාංග</div>
            </div>
          </div>
          <span style="font-size:11px;color:var(--text-4);white-space:nowrap;">← දෙපසට අදින්න →</span>
        </div>
        <div style="position:relative;">
          <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;padding:4px 0 14px;margin:0 -20px;padding-left:20px;padding-right:20px;" class="brands-scroll">
            <div style="display:flex;gap:16px;width:max-content;">
              {bathroomBrands.map(brand => {
                const m = meta(brand)
                const href = brandHref(brand)
                const isFeaturedPage = !!sponsorPage(brand)
                return (
                  <a href={href}
                    style={`display:block;width:240px;flex-shrink:0;background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #E2E2E2'};padding:20px;text-decoration:none;color:inherit;scroll-snap-align:start;position:relative;overflow:hidden;`}>
                    {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0B0B0B;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 10px;border-bottom-left-radius:10px;">අනුග්‍රාහක</div>}
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                      <div style={`width:52px;height:52px;border-radius:13px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                      <div>
                        <div style="font-size:15px;font-weight:700;color:var(--text);line-height:1.2;">{sinhalaText(brand.name)}</div>
                        {isFeaturedPage
                          ? <span style="font-size:10px;color:#8A6224;font-weight:700;">⭐ විශේෂාංගගත</span>
                          : brand.is_featured && <span style="font-size:10px;color:var(--navy);font-weight:700;">✓ සත්‍යාපිත</span>
                        }
                      </div>
                    </div>
                    <p style="font-size:11px;color:var(--text-3);line-height:1.6;margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(brand.description)}</p>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px;">
                      {(brand.categories || []).slice(0, 2).map(c => (
                        <span style="font-size:9px;padding:2px 8px;border-radius:20px;background:#F5EEE2;color:#8A6224;border:1px solid #E8DCC6;font-weight:600;">{sinhalaText(c)}</span>
                      ))}
                    </div>
                    <div style="font-size:11px;font-weight:700;color:var(--navy);">{sinhalaText(isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →')}</div>
                  </a>
                )
              })}
            </div>
          </div>
          <div style="position:absolute;top:0;right:0;width:48px;height:calc(100% - 14px);background:linear-gradient(to left,var(--surface-2),transparent);pointer-events:none;"></div>
        </div>
      </div>
    </section>
  )}

  <!-- Waterproofing Brands -->
  {waterproofBrands.length > 0 && (
    <section style="background:var(--surface);padding:52px 0 56px;border-top:1px solid var(--border);">
      <div style="max-width:1100px;margin:0 auto;padding:0 20px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#2F6B4F,#075985);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">💧</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">ජලරෝධක ද්‍රව්‍ය සහ නළ උපාංග</div>
              <div style="font-size:12px;color:var(--text-4);">ජලරෝධක පටල, සීලන්ට්, ජලාපවහන පද්ධති සහ නළ උපාංග</div>
            </div>
          </div>
          <span style="font-size:11px;color:var(--text-4);white-space:nowrap;">← දෙපසට අදින්න →</span>
        </div>
        <div style="position:relative;">
          <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;padding:4px 0 14px;margin:0 -20px;padding-left:20px;padding-right:20px;" class="brands-scroll">
            <div style="display:flex;gap:16px;width:max-content;">
              {waterproofBrands.map(brand => {
                const m = meta(brand)
                return (
                  <a href={`/brands/${brand.slug}`}
                    style={`display:block;width:240px;flex-shrink:0;background:#fff;border-radius:16px;border:1px solid #E2E2E2;padding:20px;text-decoration:none;color:inherit;scroll-snap-align:start;position:relative;overflow:hidden;`}>
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                      <div style={`width:52px;height:52px;border-radius:13px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                      <div>
                        <div style="font-size:15px;font-weight:700;color:var(--text);line-height:1.2;">{sinhalaText(brand.name)}</div>
                        <span style="font-size:10px;color:#2F6B4F;font-weight:700;">💧 ජලරෝධනය</span>
                      </div>
                    </div>
                    <p style="font-size:11px;color:var(--text-3);line-height:1.6;margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(brand.description)}</p>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px;">
                      {(brand.categories || []).slice(0, 2).map(c => (
                        <span style={`font-size:9px;padding:2px 8px;border-radius:20px;background:${m.bg}14;color:${m.bg};border:1px solid ${m.bg}28;font-weight:600;`}>{sinhalaText(c)}</span>
                      ))}
                    </div>
                    <div style="font-size:11px;font-weight:700;color:var(--navy);">සන්නාමය බලන්න →</div>
                  </a>
                )
              })}
            </div>
          </div>
          <div style="position:absolute;top:0;right:0;width:48px;height:calc(100% - 14px);background:linear-gradient(to left,var(--surface),transparent);pointer-events:none;"></div>
        </div>
      </div>
    </section>
  )}

  <!-- Shops Directory -->
  <section style="background:var(--surface-2);padding:48px 20px 64px;border-top:1px solid var(--border);">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:28px;">
        <div>
          <h2 style="font-family: var(--th-display);font-size:clamp(20px,3vw,28px);font-weight:700;color:var(--text);margin:0 0 4px;">නාන කාමර නිෂ්පාදන ප්‍රදර්ශනාගාර</h2>
          <p style="font-size:13px;color:var(--text-3);margin:0;">
            {sinhalaText(shops.length > 0 ? `වෙළෙඳසැල් ${shops.length} ක් ලැයිස්තුගත කර ඇත` : 'Be the first to list your showroom')}
          </p>
        </div>
        <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
          + ඔබේ ප්‍රදර්ශනාගාරය එක් කරන්න
        </a>
      </div>

      {shops.length > 0 ? (
        <BathroomShopsGrid client:load shops={shops} />
      ) : (
        <div style="background:#fff;border-radius:20px;border:2px dashed var(--border);padding:56px 24px;text-align:center;max-width:540px;margin:0 auto;">
          <div style="font-size:52px;margin-bottom:16px;">🚿</div>
          <h3 style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:8px;">තවම නාන කාමර ප්‍රදර්ශනාගාර ලැයිස්තුගත කර නැත</h3>
          <p style="font-size:13px;color:var(--text-3);line-height:1.8;margin-bottom:24px;max-width:380px;margin-left:auto;margin-right:auto;">
            ඔබ නාන කාමර නිෂ්පාදන, සනීපාරක්ෂක උපාංග හෝ සවිකිරීම් අලෙවි කරනවාද? අලුත්වැඩියා සැලසුම් කරන නිවාස හිමියන් සහ කොන්ත්‍රාත්කරුවන් වෙත නොමිලේ ළඟාවන්න.
          </p>
          <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
            🚿 මගේ ප්‍රදර්ශනාගාරය නොමිලේ එක් කරන්න
          </a>
          <p style="font-size:11px;color:var(--text-4);margin-top:14px;">නොමිලේ ලැයිස්තුගත කිරීම · සෘජු WhatsApp විමසුම් · කොමිස් නැත</p>
        </div>
      )}
    </div>
  </section>

  <!-- Contractor Profiles -->
  <section style="background:var(--surface);padding:52px 20px 56px;border-top:1px solid var(--border);">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:28px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:36px;height:36px;background:linear-gradient(135deg,#8A6224,#8A6224);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🏗️</div>
          <div>
            <div style="font-size:18px;font-weight:700;color:var(--text);">නාන කාමර කොන්ත්‍රාත්කරුවන්</div>
            <div style="font-size:12px;color:var(--text-4);">සවිකිරීමේ, අලුත්වැඩියා සහ ඉදිකිරීම් විශේෂඥයන්</div>
          </div>
        </div>
        <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
          + ඔබේ ව්‍යාපාරය එක් කරන්න
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px;">
        {contractors.map(c => (
          <div style="background:#fff;border-radius:18px;border:1px solid #E2E2E2;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,0.05);">
            <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:12px;">
              <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#8A6224,#8A6224);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🏗️</div>
              <div>
                <div style="font-size:15px;font-weight:800;color:var(--text);line-height:1.2;">{sinhalaText(c.name)}</div>
                {(c.city || c.district) && <div style="font-size:12px;color:var(--text-3);margin-top:2px;">📍 {sinhalaText(c.city)}{sinhalaText(c.district ? `, ${c.district}` : '')}</div>}
                <span style="font-size:10px;padding:2px 8px;border-radius:10px;background:#F2EADC;color:#242424;font-weight:700;display:inline-block;margin-top:4px;">🏗️ කොන්ත්‍රාත්කරු</span>
              </div>
            </div>
            {c.description && (
              <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin:0 0 12px;">{sinhalaText(c.description)}</p>
            )}
            {(c.services || []).length > 0 && (
              <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                {(c.services || []).slice(0,4).map(sv => (
                  <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:#F2EADC;color:#242424;border:1px solid #E8DCC6;font-weight:600;">{sinhalaText(sv)}</span>
                ))}
              </div>
            )}
            <div style="display:flex;gap:8px;">
              {(c.whatsapp || c.phone) && (
                <a href={`https://wa.me/${(c.whatsapp || c.phone).replace(/\D/g,'').replace(/^(?!94)0?/,'94')}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම වැඩHUB හරහා ${c.name} සොයාගතිමි.\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\nස්තූතියි!`)}`}
                  target="_blank" rel="noopener noreferrer"
                  style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:9px 12px;font-size:12px;font-weight:700;text-decoration:none;">
                  💬 WhatsApp
                </a>
              )}
            </div>
          </div>
        ))}

        <!-- Always show a "list your business" invite card -->
        <div style="background:#fff;border-radius:18px;border:2px dashed var(--border);padding:28px 20px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:180px;">
          <div style="font-size:36px;margin-bottom:10px;">🏗️</div>
          <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:6px;">ඔබ නාන කාමර කොන්ත්‍රාත්කරුවෙක්ද?</div>
          <p style="font-size:12px;color:var(--text-3);line-height:1.6;margin-bottom:14px;">ඔබේ ව්‍යාපාරය නොමිලේ ලැයිස්තුගත කර අලුත්වැඩියා සැලසුම් කරන නිවාස හිමියන්ගෙන් විමසුම් ලබාගන්න.</p>
          <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:6px;background:var(--navy);color:#fff;border-radius:10px;padding:9px 18px;font-size:12px;font-weight:700;text-decoration:none;">
            + මගේ ව්‍යාපාරය එක් කරන්න
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA for homeowners -->
  <section style="background:var(--surface);padding:44px 20px;border-top:1px solid var(--border);text-align:center;">
    <div style="max-width:560px;margin:0 auto;">
      <h2 style="font-family: var(--th-display);font-size:clamp(20px,3vw,28px);font-weight:700;color:var(--text);margin-bottom:10px;">නාන කාමරයක් අලුත්වැඩියා කිරීමට සැලසුම් කරනවාද?</h2>
      <p style="font-size:13px;color:var(--text-3);margin-bottom:24px;line-height:1.8;">ඔබේ ව්‍යාපෘතිය පළ කර ඔබ අසල සත්‍යාපිත ටයිල් කාර්මිකයන්, කොන්ත්‍රාත්කරුවන් සහ නාන කාමර විශේෂඥයන් සමඟ සම්බන්ධ වන්න.</p>
      <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:var(--terra);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
        📋 මගේ නාන කාමර ව්‍යාපෘතිය පළ කරන්න
      </a>
    </div>
  </section>

</Layout>

