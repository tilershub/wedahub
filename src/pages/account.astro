---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import Dashboard from '../components/Dashboard.jsx'

if (!Astro.locals.user) return Astro.redirect('/login')

const supabase = Astro.locals.supabase
const user = Astro.locals.user

const [{ data: projects }, { data: provider }] = await Promise.all([
  supabase.from('projects').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
  supabase.from('providers').select('*').eq('user_id', user.id).maybeSingle(),
])

const projectIds = (projects || []).map(p => p.id)
const { data: bids } = projectIds.length
  ? await supabase.from('bids').select('*').in('job_id', projectIds).order('created_at', { ascending: false })
  : { data: [] }
---

<Layout
  title="මගේ ගිණුම · වැඩHUB"
  description="වැඩHUB හි ඔබේ ව්‍යාපෘති කළමනාකරණය කර මිල ගණන් බලා සේවා සපයන්නන් සම්බන්ධ කරගන්න."
  noindex={true}
>
  <div style="max-width:1200px;margin:20px auto;padding:0 20px"><a href="/my-jobs" style="color:var(--navy);font-weight:700">මගේ වැඩ සහ සමාලෝචන →</a></div>
  <Dashboard
    initialRole={await Astro.locals.accountRole()}
    initialUser={user}
    initialProjects={projects ?? []}
    initialProvider={provider}
    initialBids={bids ?? []}
    client:only="react"
  />
</Layout>
