---
import Layout from '../../layouts/Layout.astro'
import PageIntro from '../../components/PageIntro.astro'
import { CATEGORIES } from '../../lib/categories.js'
import { SERVICES } from '../../lib/services.js'
const cat = CATEGORIES.find(c => c.slug === Astro.params.slug)
if (!cat) return Astro.rewrite('/404')
const services = SERVICES.filter(s => cat.terms.some(t => [s.label,...s.terms].join(' ').toLowerCase().includes(t)))
---
<Layout title={`${cat.si} · වැඩHUB`} description={cat.desc}><div class="wh-container"><PageIntro title={cat.si} subtitle={cat.desc}/><div class="wh-category-grid">{services.map(s=><a href={`/services/${s.slug}`}><strong>{s.si || s.label}</strong><small>සේවා සපයන්නන් බලන්න →</small></a>)}</div><p style="margin-top:24px"><a class="wh-button" href="/providers">සියලු සේවා සපයන්නන් →</a></p></div></Layout>
