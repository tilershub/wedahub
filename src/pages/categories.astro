---
import Layout from '../layouts/Layout.astro'
import PageIntro from '../components/PageIntro.astro'
import AppIcon from '../components/AppIcon.jsx'
import { CATEGORIES } from '../lib/categories.js'
---
<Layout title="සියලු සේවා · වැඩHUB" description="Explore services for everyday life, home, work, learning and business across Sri Lanka."><div class="wh-container"><PageIntro title="සෑම අවශ්‍යතාවකටම සේවාවක්." subtitle="ඔබට අවශ්‍ය සේවා වර්ගය තෝරන්න."/><div class="wh-category-grid">{CATEGORIES.map(c=><a href={`/categories/${c.slug}`}><span class="wh-icon-tile"><AppIcon name={c.symbol}/></span><strong>{c.si}</strong><small>{c.label}</small></a>)}</div><section class="wh-next" style="margin-top:24px"><div><h2>ඔබේ සේවාව මෙහි නැද්ද?</h2><p>වෙනත් සේවාවක් ලෙස ලියාපදිංචි වී ඔබේ හැකියාව විස්තර කරන්න.</p></div><a class="wh-button" href="/join-wedahub">එක්වන්න →</a></section></div></Layout>
