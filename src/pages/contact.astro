---
import { si as sinhalaText } from '../lib/sinhala.js'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="වැඩHUB අමතන්න · අප සමඟ සම්බන්ධ වන්න"
  description="ලැයිස්තුගත කිරීම්, හවුල්කාරිත්වයන් හෝ ශ්‍රී ලංකාවේ ටයිල් වෙළෙඳපොළ ගැන ප්‍රශ්න සඳහා වැඩHUB කණ්ඩායම අමතන්න."
>

  <!-- Hero -->
  <div style="background:var(--navy);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(255,255,255,0.8) 20px,rgba(255,255,255,0.8) 21px);pointer-events:none;"></div>
    <div style="position:relative;max-width:560px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">📬 සම්බන්ධ වන්න</span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,40px);font-weight:700;color:#fff;margin:12px 0 10px;line-height:1.2;">
        අප හා <span style="color:var(--gold);">සම්බන්ධ වන්න</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);line-height:1.8;">ප්‍රශ්න, හවුල්කාරිත්ව, හෝ ලැයිස්තු විමසීම් — අපි සෑම විටම ප්‍රතිචාර දක්වන්නෙමු.</p>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 20px 64px;">
    <div class="contact-grid">

      <!-- Contact Options -->
      <div>
        <h2 style="font-family: var(--th-display);font-size:22px;font-weight:700;color:var(--text);margin-bottom:24px;">සම්බන්ධ වන ආකාරය</h2>

        <div style="display:flex;flex-direction:column;gap:14px;">

          <a href="https://wa.me/94774503744?text=Hi%20වැඩHUB%2C%20I%20have%20a%20question%20about%20your%20platform." target="_blank" rel="noopener" class="contact-card">
            <div style="width:48px;height:48px;border-radius:14px;background:#E9F1EC;border:1px solid #C6DDCF;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">💬</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;">WhatsApp</div>
              <div style="font-size:12px;color:var(--text-3);">ඉක්මන්ම ප්‍රතිචාරය — අපව සෘජුවම chat කරන්න</div>
              <div style="font-size:12px;font-weight:600;color:#2F6B4F;margin-top:4px;">+94 77 450 3744</div>
            </div>
          </a>

          <a href="mailto:Tilershub@gmail.com" class="contact-card">
            <div style="width:48px;height:48px;border-radius:14px;background:var(--navy-50);border:1px solid var(--navy-100);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">📧</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;">ඊමේල්</div>
              <div style="font-size:12px;color:var(--text-3);">ව්‍යාපාරික දිනයක් ඇතුළත ප්‍රතිචාර දෙමු</div>
              <div style="font-size:12px;font-weight:600;color:var(--navy);margin-top:4px;">Tilershub@gmail.com</div>
            </div>
          </a>

          <a href="https://www.facebook.com/share/1BLsTEZ1qW/?mibextid=wwXIfr" target="_blank" rel="noopener" class="contact-card">
            <div style="width:48px;height:48px;border-radius:14px;background:#F5EEE2;border:1px solid #E8DCC6;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">👥</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;">Facebook</div>
              <div style="font-size:12px;color:var(--text-3);">අපේ page like කරන්න සහ community හා එකතු වන්න</div>
              <div style="font-size:12px;font-weight:600;color:#1877F2;margin-top:4px;">වැඩHUB ශ්‍රී ලංකාව</div>
            </div>
          </a>

        </div>

        <div style="margin-top:28px;padding:20px;background:var(--surface-2);border-radius:16px;border:1px solid var(--border);">
          <div style="font-size:12px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;">ඉක්මන් සබැඳි</div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/join-wedahub" style="font-size:13px;color:var(--navy);font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;">✅ සේවා සපයන්නෙකු ලෙස එකතු වන්න →</a>
            <a href="/post-project" style="font-size:13px;color:var(--navy);font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;">📋 ව්‍යාපෘතිය පලකරන්න →</a>
            <a href="/providers" style="font-size:13px;color:var(--navy);font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;">👷 සේවා සපයන්නන් සොයන්න →</a>
          </div>
        </div>
      </div>

      <!-- Topic Guide -->
      <div>
        <h2 style="font-family: var(--th-display);font-size:22px;font-weight:700;color:var(--text);margin-bottom:24px;">සාමාන්‍ය විමසීම්</h2>

        {[
          { icon: '👷', q: 'මගේ ව්‍යාපාරය ලැයිස්තු කිරීමට කැමැත්තෙමි', a: 'නොමිලේ "Join as Provider" ෆෝමය භාවිතා කරන්න. සියලු ඉල්ලීම් ව්‍යාපාරික දින 1–2 ඇතුළත සමාලෝචනය කර WhatsApp හරහා සම්බන්ධ වෙමු.' },
          { icon: '📋', q: 'ව්‍යාපෘතිය පලකිරීමට කැමැත්තෙමි', a: '"Post a Project" පිටුව භාවිතා කරන්න — ලොගිනයක් අවශ්‍ය නැත. ව්‍යාපෘතිය විස්තර කරන්න, සත්‍යාපිත ටයිලර්ලා සෘජුවම සම්බන්ධ වනු ඇත.' },
          { icon: '🏷️', q: 'ටයිල් බ්‍රෑන්ඩ් හවුල්කාරිත්ව', a: 'Tilershub@gmail.com ට ඊමේල් කරන්න හෝ WhatsApp කරන්න. ප්‍රදර්ශිත බ්‍රෑන්ඩ් ලැයිස්තු සහ sponsored placement ලබා දෙමු.' },
          { icon: '❌', q: 'මගේ ලැයිස්තුව ඉවත් කිරීම', a: 'ව්‍යාපාරයේ නම සමඟ WhatsApp හෝ ඊමේල් කරන්න, පැය 24ක් ඇතුළත ලැයිස්තුව ඉවත් කෙරේ.' },
          { icon: '🐛', q: 'ගැටලුවක් වාර්තා කිරීම', a: 'screenshot සහ ගැටලු විස්තරය සමඟ WhatsApp හරහා සම්බන්ධ වන්න. සියලු වාර්තා අපි විමර්ශනය කරමු.' },
        ].map(item => (
          <div style="padding:16px;background:#fff;border:1px solid var(--border);border-radius:14px;margin-bottom:12px;">
            <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:6px;display:flex;align-items:center;gap:8px;">{sinhalaText(item.icon)} {sinhalaText(item.q)}</div>
            <p style="font-size:13px;color:var(--text-3);line-height:1.7;margin:0;">{sinhalaText(item.a)}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <style>
    .contact-grid {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: start;
    }
    .contact-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      background: #fff;
      border: 1.5px solid var(--border);
      border-radius: 16px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, transform 0.2s;
    }
    .contact-card:hover {
      border-color: var(--navy);
      transform: translateY(-2px);
    }
    @media (max-width: 640px) {
      .contact-grid { grid-template-columns: 1fr; }
    }
  </style>

</Layout>
