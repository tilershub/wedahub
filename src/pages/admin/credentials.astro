---
export const prerender = false
const db = Astro.locals.supabase
const { data: admin, error: authError } = Astro.locals.user ? await db.rpc('is_admin') : { data:false,error:null }
if (authError || admin !== true) return Astro.redirect('/login')
Astro.response.headers.set('Cache-Control','no-store')
Astro.response.headers.set('Referrer-Policy','no-referrer')
let error = ''
const types = ['identity','credential','licence','business','industry_registration']
if (Astro.request.method === 'POST') {
 if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response('Origin not allowed',{status:403})
 try {
  if (Number(Astro.request.headers.get('content-length')) > 12000) throw new Error('Request too large')
  const raw = await Astro.request.text()
  if (raw.length > 12000) throw new Error('Request too large')
  const form = new URLSearchParams(raw)
  if (form.get('action') === 'issuer') {
   const name = form.get('name')?.trim() || '', website = form.get('website')?.trim() || null
   const selected = form.getAll('types').filter(value=>types.includes(value))
   if (name.length<2 || name.length>160 || !selected.length || (website && !website.startsWith('https://'))) throw new Error('Invalid issuer')
   const { error:e }=await db.from('trusted_issuers').insert({name,website,credential_types:selected})
   if(e) throw e
  } else if(form.get('action') === 'issuer_status') {
   const {data,error:e}=await db.from('trusted_issuers').update({active:form.get('active')==='true'}).eq('id',form.get('id')).select('id')
   if(e||!data?.length)throw e||new Error('Issuer changed')
  } else if(form.get('action') === 'review') {
   const status=form.get('status'),method=form.get('method'),note=form.get('note')?.trim()||''
   if(!['verified','rejected'].includes(status||'') || !['manual','issuer_contact'].includes(method||'') || note.length<10 || note.length>2000)throw new Error('Invalid review')
   const {data,error:e}=await db.from('provider_credentials').update({status,verification_method:method,review_note:note}).eq('id',form.get('id')).eq('updated_at',form.get('version')).select('id')
   if(e||!data?.length)throw e||new Error('Review changed')
  } else throw new Error('Unknown action')
  return Astro.redirect('/admin/credentials',303)
 }catch{error='Unable to save. Check the issuer, expiry, review rationale and whether this record changed. You cannot review your own credential.'}
}
const [{data:rows,error:loadError},{data:issuers,error:issuerError}]=await Promise.all([
 db.from('provider_credentials').select('*').in('status',['pending','verified']).order('updated_at',{ascending:false}).limit(100),
 db.from('trusted_issuers').select('*').order('name').limit(500)
])
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Credential review · වැඩHUB</title></head>
<body><main>
 <a href="/admin">← Administration</a><h1>Credential verification</h1>
 <p>Private evidence. Check the issuing institution and document yourself. An upload is not proof of authenticity. Only the approved title and verification type become public; never place certificate numbers or private information in the title.</p>
 {error&&<p role="alert">{error}</p>}{(loadError||issuerError)&&<p role="alert">Could not load the review queue.</p>}
 <h2>Trusted issuer registry</h2><p>Only add recognized institutions after checking their authority. Registry membership does not automatically verify a document. Disabling an issuer prevents new approvals; review existing badges separately.</p>
 <details><summary>Add a recognized issuer</summary><form method="post">
 <input type="hidden" name="action" value="issuer"/>
 <label>Institution name<input name="name" required minlength="2" maxlength="160"/></label>
 <label>Official website<input name="website" type="url" placeholder="https://" maxlength="500"/></label>
 <fieldset><legend>Authorized credential types</legend>{types.map(type=><label class="inline"><input type="checkbox" name="types" value={type}/>{type.replaceAll('_',' ')}</label>)}</fieldset>
 <button>Add issuer</button></form></details>
 {(issuers||[]).map(issuer=><details><summary>{issuer.name} — {issuer.active?'Active':'Inactive'}</summary><p>{issuer.credential_types.join(', ')}</p><form method="post"><input type="hidden" name="action" value="issuer_status"/><input type="hidden" name="id" value={issuer.id}/><input type="hidden" name="active" value={issuer.active?'false':'true'}/><button>{issuer.active?'Deactivate':'Activate'}</button></form></details>)}
 <h2>Pending and approved credentials</h2><p>Latest 100 records. Rejected records remain in the private database and audit history.</p>
 {(rows||[]).map(row=><article>
 <h3>{row.qualification_name}</h3><p>{row.credential_type} · {row.status} · Provider ID: {row.provider_id}</p>
 <dl><dt>Claimed issuing organization</dt><dd>{row.issuing_organization}</dd><dt>Registry issuer</dt><dd>{issuers?.find(i=>i.id===row.issuer_id)?.name || 'Not recognized — add the issuer and ask for a new submission'}</dd><dt>Field / level</dt><dd>{row.field||'—'} / {row.level||'—'}</dd><dt>Certificate number</dt><dd>{row.certificate_number||'Not provided'}</dd><dt>Issued / expires</dt><dd>{row.issue_date||'Not provided'} / {row.expiry_date||'Not provided'}</dd></dl>
 {row.document_path&&<a href={`/api/admin/credential-document?id=${row.id}`} rel="noreferrer">Download private evidence (short-lived link)</a>}
 {row.review_note&&<p>Previous decision: {row.review_note}</p>}
 <form method="post"><input type="hidden" name="action" value="review"/><input type="hidden" name="id" value={row.id}/><input type="hidden" name="version" value={row.updated_at}/>
 <label>Verification method<select name="method"><option value="manual">Manual document and issuer check</option><option value="issuer_contact">Confirmed directly with issuer</option></select></label>
 <label>Decision rationale (visible to the provider)<textarea name="note" required minlength="10" maxlength="2000"/></label>
 <button name="status" value="verified">Approve verification</button><button name="status" value="rejected">Reject / revoke</button>
 </form></article>)}
 </main></body></html>
<style>
 body{margin:0;background:#F7F3E8;color:#0B2A4A;font:16px/1.6 system-ui}main{max-width:900px;margin:auto;padding:24px}a{color:#0B2A4A}article,details{background:white;border:1px solid #EAE4D7;border-radius:12px;padding:20px;margin:16px 0}label{display:block;margin:12px 0}.inline{display:inline-block;margin-right:16px}input:not([type=checkbox]),select,textarea{display:block;box-sizing:border-box;width:100%;padding:12px;font:inherit;border:1px solid #ccc;border-radius:6px}button{background:#0B2A4A;color:white;border:0;border-radius:8px;padding:14px;margin:8px 12px 8px 0;min-height:48px;font:inherit}dt{font-weight:700}dd{margin:0 0 10px}summary{cursor:pointer}[role=alert]{color:#A52323}
</style>
