---
export const prerender = false
const { id } = Astro.params
import BlogEditor from '../../../components/BlogEditor.jsx'
---
<!DOCTYPE html>
<html lang="si" data-lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ලිපිය සංස්කරණය කරන්න · වැඩHUB පරිපාලනය</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: #ECECEC; font-family: system-ui, -apple-system, sans-serif; color: #0B0B0B; }
  </style>
</head>
<body>
  <BlogEditor client:only="react" mode="edit" blogId={id} />
</body>
</html>
