---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import PhoneAuth from '../components/PhoneAuth.jsx'
import { t } from '../lib/i18n.js'

const lang = Astro.locals.lang || 'si'
const redirectTo = Astro.url.searchParams.get('next') || '/account'

// Already signed in — nothing to do here.
if (Astro.locals.user) return Astro.redirect(redirectTo)
---

<Layout
  title={`${t('signIn', lang)} · වැඩHUB`}
  description="වැඩHUB වෙත ඔබේ ජංගම දුරකථන අංකයෙන් පිවිසෙන්න."
  noindex={true}
>
  <div style="min-height:var(--th-fill);display:flex;align-items:center;justify-content:center;padding:24px 16px;background:var(--surface-2);">
    <PhoneAuth client:load lang={lang} redirectTo={redirectTo} />
  </div>
</Layout>
