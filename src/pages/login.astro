---
import Layout from '../layouts/Layout.astro'
import AuthButton from '../components/AuthButton.jsx'
---

<Layout
  title="පිවිසෙන්න · වැඩHUB"
  description="ඔබේ ව්‍යාපෘති සහ සේවා පැතිකඩ කළමනාකරණයට වැඩHUB වෙත පිවිසෙන්න."
  noindex={true}
>
  <div style="background:var(--surface);min-height:var(--th-fill);display:flex;align-items:center;justify-content:center;padding:40px 20px;">
    <div style="width:100%;max-width:420px;text-align:center;">

      <div style="margin-bottom:28px;">
        <div style="font-family: var(--th-display);font-size:26px;font-weight:700;color:var(--text);margin-bottom:8px;">
          <span class="si-text"><span style="color:var(--terra);">වැඩHUB</span> සාදරයෙන් පිළිගනිමු</span>
          <span class="en-text">සාදරයෙන් පිළිගනිමු <span style="color:var(--terra);">වැඩHUB</span></span>
        </div>
        <p style="font-size:14px;color:var(--text-3);line-height:1.7;">
          <span class="si-text">ඔබේ ව්‍යාපෘති සොයා ගැනීමට සහ පැතිකඩ කළමනාකරණය සඳහා ලොගින් වන්න.</span>
          <span class="en-text">ඔබේ ව්‍යාපෘති සහ පැතිකඩ කළමනාකරණයට පිවිසෙන්න.</span>
        </p>
      </div>

      <!-- AuthButton handles the full login modal flow -->
      <div style="display:flex;justify-content:center;">
        <AuthButton client:load autoOpen />
      </div>

      <p style="font-size:12px;color:var(--text-4);margin-top:24px;line-height:1.7;">
        <span class="si-text">ව්‍යාපෘතිය පලකිරීමට හෝ සේවා සපයන්නන් සම්බන්ධ කර ගැනීමට ගිණුමක් අවශ්‍ය නැත.<br/>
        ගිණුමෙන් ඔබේ ඉල්ලීම් නිරීක්ෂණය කළ හැකිය.</span>
        <span class="en-text">ව්‍යාපෘතියක් පළ කිරීමට හෝ සේවා සපයන්නන් ඇමතීමට ගිණුමක් අවශ්‍ය නැත.<br/>
        ගිණුමකින් ඔබේ ඉල්ලීම් පිළිබඳ තොරතුරු බැලිය හැකිය.</span>
      </p>

      <div style="margin-top:28px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/post-project" class="btn btn-terra">📋 <span class="si-text">ව්‍යාපෘතිය පලකරන්න</span><span class="en-text">ව්‍යාපෘතියක් පළ කරන්න</span></a>
        <a href="/providers" class="btn btn-outline">👷 <span class="si-text">ටයිලර් සොයන්න</span><span class="en-text">ටයිල් කාර්මිකයන් සොයන්න</span></a>
      </div>
    </div>
  </div>
</Layout>
