---
import Layout from '../layouts/Layout.astro'
import PageIntro from '../components/PageIntro.astro'
import JoinForm from '../components/JoinForm.jsx'
---
<Layout title="ඔබේ හැකියාවට අවස්ථාවක්. · වැඩHUB" description="Register any service on WedaHUB. For independent professionals, teams and service businesses."><div class="wh-container" style="max-width:720px"><PageIntro title="ඔබේ හැකියාවට අවස්ථාවක්." subtitle="සෑම සේවා සපයන්නෙකුටම තැනක්. ඔබේ සේවාව තෝරා ලියාපදිංචි වන්න."/><section class="wh-panel"><JoinForm client:load initialUser={Astro.locals.user}/></section></div></Layout>
