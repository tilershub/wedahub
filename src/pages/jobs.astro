---
import Layout from '../layouts/Layout.astro'
import JobsBoard from '../components/JobsBoard.jsx'

// SSR seed: the island's server-rendered HTML then contains real job cards
// with crawlable /jobs/<slug> links instead of a loading skeleton.
const supabase = Astro.locals.supabase
const { data: initialProjectsRaw } = await supabase
  .from('projects')
  .select('id, project_type, city, district, description, budget_range, created_at')
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(30)
const initialProjects = initialProjectsRaw || []

let initialBidCounts = {}
if (initialProjects.length > 0) {
  const { data: bids } = await supabase
    .from('bids')
    .select('job_id')
    .in('job_id', initialProjects.map(j => j.id))
  for (const b of bids || []) initialBidCounts[b.job_id] = (initialBidCounts[b.job_id] || 0) + 1
}
---

<Layout
  title="ටයිල් වැඩ බලන්න · වැඩHUB"
  description="ඔබ අසල ටයිල් සහ අලුත්වැඩියා ව්‍යාපෘති සොයන්න. වැඩHUB හි ශ්‍රී ලංකාව පුරා නිවාස හිමියන් පළ කළ විවෘත වැඩ බලන්න."
>

  <div style="background:var(--navy);padding:44px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">💼 <span class="si-text">විවෘත රැකියා</span><span class="en-text">විවෘත වැඩ</span></span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:12px 0 10px;line-height:1.2;">
        <span class="si-text"><span style="color:var(--terra-lift);">ටයිලිං ව්‍යාපෘති</span> බලන්න</span>
        <span class="en-text">බලන්න <span style="color:var(--terra-lift);">ටයිල් ව්‍යාපෘති</span></span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto;">
        <span class="si-text">ශ්‍රී ලංකාව පුරා ගෙදර හිමිකරුවන් ලිය කළ ව්‍යාපෘති. සම්බන්ධ වීමේ විස්තර බැලීමට ලොගින් වන්න.</span>
        <span class="en-text">ශ්‍රී ලංකාව පුරා නිවාස හිමියන් පළ කළ ව්‍යාපෘති. සම්බන්ධතා විස්තර බැලීමට පිවිසෙන්න.</span>
      </p>
    </div>
  </div>

  <JobsBoard initialProjects={initialProjects} initialBidCounts={initialBidCounts} client:load />

  <!-- Ad slot — below the project board. Browsing surface, not a form, so an
       ad here is safe; keep it under the listings so bidding is never pushed
       below the fold.
       Create the unit in AdSense, paste its slot ID, uncomment, and add
       `import AdSlot from '../components/AdSlot.jsx'` to the frontmatter.
       <AdSlot slot="REPLACE_ME" client:visible /> -->

</Layout>
