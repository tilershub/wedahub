---
import { si as sinhalaText } from '../lib/sinhala.js'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="වැඩHUB ගැන · ශ්‍රී ලංකාවේ ටයිල් වෙළෙඳපොළ"
  description="වැඩHUB ශ්‍රී ලංකාව පුරා නිවාස හිමියන් සහ සත්‍යාපිත ටයිල් කාර්මිකයන්, වැඩපොළ, සැපයුම්කරුවන් සහ ටයිල් සන්නාම සම්බන්ධ කරයි."
>

  <!-- Hero -->
  <div style="background:var(--navy);padding:60px 20px 52px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(255,255,255,0.8) 20px,rgba(255,255,255,0.8) 21px);pointer-events:none;"></div>
    <div style="position:absolute;top:-80px;right:-80px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(212,161,94,0.1) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="position:relative;max-width:640px;margin:0 auto;">
      <div style="font-size:9px;font-weight:700;color:rgba(212,161,94,0.65);letter-spacing:3px;text-transform:uppercase;margin-bottom:14px;">වැඩHUB ගැන</div>
      <h1 style="font-family: var(--th-display);font-size:clamp(28px,5vw,48px);font-weight:700;color:#fff;margin-bottom:16px;line-height:1.15;">
        ශ්‍රී ලංකාවේ විශ්වාසදායී<br/><span style="color:var(--gold);">ටයිලිං වෙළෙඳපොළ</span>
      </h1>
      <p style="font-size:15px;color:rgba(255,255,255,0.55);line-height:1.9;max-width:480px;margin:0 auto;">
        ගෙදර හිමිකරුවන් සහ සත්‍යාපිත ටයිලර්, වැඩමුළු, සැපයුම්කරුවන් සහ ටයිල් බ්‍රෑන්ඩ් — නොමිලේ, සෘජුව, island-wide.
      </p>
    </div>
  </div>

  <!-- Mission -->
  <section style="background:var(--surface);padding:60px 20px;">
    <div style="max-width:720px;margin:0 auto;text-align:center;">
      <span class="section-label">අපගේ අරමුණ</span>
      <h2 class="section-title" style="margin-top:10px;">ශ්‍රී ලංකාවේ <em>ටයිලිං කර්මාන්තය</em> සඳහා</h2>
      <p style="font-size:15px;color:var(--text-3);line-height:1.9;max-width:600px;margin:0 auto 36px;">
        වැඩHUB ගොඩ නැඟුයේ සැබෑ ගැටලුවක් විසඳීමට — ගෙදර හිමිකරුවන්ට විශ්වාසදායී ටයිලිං වෘත්තිකයන් සොයා ගැනීම අසීරු වූ අතර, දක්ෂ ටයිලර්ලාට පහසුවෙන් ගනුදෙනුකරුවන් ලබා ගත නොහැකි විය. නොමිලේ, විවෘත වෙළෙඳපොළක් නිර්මාණය කර දෙපාර්ශ්වය සෘජුව සම්බන්ධ කළෙමු.
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;text-align:center;">
        {/* Only claims we can stand behind. A provider headcount belongs on
            /providers, where it is counted from the live directory rather
            than typed in by hand. */}
        {[
          { n: '25', l: 'දිස්ත්‍රික්ක ආවරණය', icon: '🗺️' },
          { n: '100%', l: 'නොමිලේ සේවාව', icon: '✅' },
          { n: '0%', l: 'කොමිෂන්', icon: '💸' },
          { n: 'ලොගින් නැත', l: 'ව්‍යාපෘතියක් පලකිරීමට', icon: '⚡' },
        ].map(s => (
          <div style="padding:24px;background:var(--surface-2);border:1px solid var(--border);border-radius:16px;">
            <div style="font-size:28px;margin-bottom:8px;">{sinhalaText(s.icon)}</div>
            <div style="font-family: var(--th-display);font-size:28px;font-weight:700;color:var(--navy);margin-bottom:4px;">{sinhalaText(s.n)}</div>
            <div style="font-size:12px;color:var(--text-3);">{sinhalaText(s.l)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section style="background:var(--surface-2);padding:60px 20px;border-top:1px solid var(--border);">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:44px;">
        <span class="section-label">ක්‍රියාවලිය</span>
        <h2 class="section-title" style="margin-top:10px;">සරලයි. <em>සෘජුවයි. නොමිලේ.</em></h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;">
        {[
          { step: '01', icon: '🔍', title: 'සොයන්න සහ සොයා ගන්න', desc: 'සත්‍යාපිත ටයිලර්, වැඩමුළු, සැපයුම්කරුවන් සහ ටයිල් බ්‍රෑන්ඩ් බලන්න. දිස්ත්‍රික්කය, සේවා වර්ගය හෝ නම අනුව පෙරන්න.' },
          { step: '02', icon: '💬', title: 'සෘජුව සම්බන්ධ වන්න', desc: 'WhatsApp ඔබාගෙන ඕනෑම සේවා සපයන්නෙකුට සෘජුව message කරන්න — කිසිදු මැදිහත්කරුවෙකු, ගාස්තුවක් හෝ කොමිෂනයක් නොමැතිව.' },
          { step: '03', icon: '📋', title: 'ව්‍යාපෘතිය පලකරන්න', desc: 'ඔබේ ටයිලිං ව්‍යාපෘතිය විස්තර කරන්න, සත්‍යාපිත වෘත්තිකයන් ගාස්තු සමඟ ඔබව සොයා ගනු ඇත.' },
          { step: '04', icon: '🏠', title: 'කාර්ය සිදු කරන්න', desc: 'ගාස්තු එකඟ වී, කාලය නියම කර, විශ්වාසදායී වෘත්තිකයෙකු ලවා ගුණාත්මක ටයිලිං ලබා ගන්න.' },
        ].map(s => (
          <div style="padding:28px 24px;background:#fff;border-radius:16px;border:1px solid var(--border);">
            <div style="font-size:11px;font-weight:800;color:var(--terra);letter-spacing:2px;margin-bottom:12px;">{sinhalaText(s.step)}</div>
            <div style="font-size:32px;margin-bottom:14px;">{sinhalaText(s.icon)}</div>
            <h3 style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:8px;">{sinhalaText(s.title)}</h3>
            <p style="font-size:13px;color:var(--text-3);line-height:1.7;">{sinhalaText(s.desc)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who's on වැඩHUB -->
  <section style="background:var(--surface);padding:60px 20px;border-top:1px solid var(--border);">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:44px;">
        <span class="section-label">ලැයිස්තු ගත වූ අය</span>
        <h2 class="section-title" style="margin-top:10px;"><em>ටයිලිං කර්මාන්තයේ</em> සෑම කොටසක්ම</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">
        {[
          { icon: '👷', type: 'ටයිලර්', desc: 'මහල, බිත්ති, නාන කාමර සහ විශේෂ ටයිලිං වෘත්තිකයන්. TH Verified සහ Certified Pro මට්ටම් ලබා ගත හැකිය.', href: '/providers' },
          { icon: '🏭', type: 'වැඩමුළු', desc: 'ග්‍රැනයිට් කැපීම, ටයිල් කැපීම සහ routering නිශ්චිත උපකරණ සහිතව.', href: '/providers?type=workshop' },
          { icon: '📦', type: 'සැපයුම්කරුවන්', desc: 'ටයිල් grout, ඇලවුම්, මෙවලම් සහ ද්‍රව්‍ය — trade සහ සිල්ලර ගනුදෙනුකරුවන්ට.', href: '/providers?type=supplier' },
          { icon: '🏪', type: 'ටයිල් සාප්පු', desc: 'ස්ථානීය සහ ආනයනික ටයිල් brands සියලු අයවැය සඳහා stock කරන retail showrooms.', href: '/providers?type=tile_shop' },
          { icon: '🏷️', type: 'ටයිල් බ්‍රෑන්ඩ්', desc: 'ශ්‍රී ලංකාවේ ප්‍රමුඛ ටයිල් brands — collections බලා ආසන්නයේ authorized dealers සොයන්න.', href: '/brands' },
          { icon: '🚿', type: 'ප්‍රතිසංස්කරණ', desc: 'design, supply සහ installation සහිත සම්පූර්ණ නාන කාමර සහ මහල් ප්‍රතිසංස්කරණ සමාගම්.', href: '/providers' },
        ].map(p => (
          <a href={p.href} style="display:block;padding:22px;background:var(--surface-2);border:1px solid var(--border);border-radius:16px;text-decoration:none;color:inherit;transition:all 0.2s;"
            onmouseover="this.style.borderColor='var(--navy)';this.style.transform='translateY(-2px)'"
            onmouseout="this.style.borderColor='var(--border)';this.style.transform='none'">
            <div style="font-size:32px;margin-bottom:12px;">{sinhalaText(p.icon)}</div>
            <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:6px;">{sinhalaText(p.type)}</div>
            <p style="font-size:12px;color:var(--text-3);line-height:1.7;margin:0;">{sinhalaText(p.desc)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section style="background:var(--navy);padding:60px 20px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:radial-gradient(circle,rgba(255,255,255,0.8) 1px,transparent 1px);background-size:24px 24px;pointer-events:none;"></div>
    <div style="max-width:800px;margin:0 auto;text-align:center;position:relative;">
      <div style="font-size:9px;font-weight:700;color:rgba(212,161,94,0.65);letter-spacing:3px;text-transform:uppercase;margin-bottom:14px;">අපගේ වටිනාකම්</div>
      <h2 style="font-family: var(--th-display);font-size:clamp(24px,4vw,36px);font-weight:700;color:#fff;margin-bottom:40px;">අපි නියෝජනය කරන දේ</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;">
        {[
          { icon: '🆓', v: 'සෑම විටම නොමිලේ', d: 'subscription නැත, commission නැත — වැඩHUB ගෙදර හිමිකරුවන්ට සහ සේවා සපයන්නන්ට නොමිලේ.' },
          { icon: '✅', v: 'සත්‍යාපනය ප්‍රථමයෙන්', d: 'TH Verified badge ලබා දීමට පෙර සේවා සපයන්නන් අතින් සමාලෝචනය කර සත්‍යාපනය කරමු.' },
          { icon: '📞', v: 'සෘජු සම්බන්ධතා', d: 'WhatsApp හරහා සෘජුව — call centres නැත, ticketing systems නැත, ප්‍රමාද නැත.' },
          { icon: '🇱🇰', v: 'ලංකාව සඳහා', d: 'ශ්‍රී ලංකාවේ ටයිලිං වෙළෙඳපොළ සඳහා විශේෂයෙන් නිර්මාණය කළ, සිංහල සහාය සහිතව.' },
        ].map(item => (
          <div style="padding:24px 20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:16px;text-align:center;">
            <div style="font-size:32px;margin-bottom:12px;">{sinhalaText(item.icon)}</div>
            <div style="font-size:14px;font-weight:700;color:#fff;margin-bottom:8px;">{sinhalaText(item.v)}</div>
            <p style="font-size:12px;color:rgba(255,255,255,0.4);line-height:1.7;margin:0;">{sinhalaText(item.d)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--surface);padding:52px 20px;border-top:1px solid var(--border);">
    <div style="max-width:540px;margin:0 auto;text-align:center;">
      <span class="section-label">ආරම්භ කරන්න</span>
      <h2 class="section-title" style="margin-top:10px;"><em>සුදුසු ටයිලර්</em> සොයා ගැනීමට සූදානම්ද?</h2>
