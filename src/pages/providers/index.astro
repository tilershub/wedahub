---
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import PageIntro from '../../components/PageIntro.astro'
import ProviderDirectory from '../../components/ProviderDirectory.jsx'
import { PROFESSIONS } from '../../lib/professions.js'
const requestedType = Astro.url.searchParams.get('type') || ''
const type = PROFESSIONS.some(p => p.value === requestedType) ? requestedType : ''
---
<Layout title="සේවා සපයන්නන් සොයන්න · වැඩHUB" description="Search service providers across Sri Lanka, from home repairs and cleaning to tutoring, transport, beauty and digital services. Compare profiles and contact directly.">
  <div class="wh-container"><PageIntro title="ඔබේ වැඩේට හරි කෙනා." subtitle="සේවාව සහ ප්‍රදේශය තෝරා පැතිකඩ, හැකියාවන් සහ සමාලෝචන සසඳන්න."/>
    <ProviderDirectory client:load initialType={type} initialSearch={Astro.url.searchParams.get('q') || Astro.url.searchParams.get('search') || ''} initialDistrict={Astro.url.searchParams.get('district') || ''}/>
  </div>
</Layout>
