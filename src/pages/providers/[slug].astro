---
import { si as sinhalaText } from '../../lib/sinhala.js'
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import ConfirmedPortfolio from '../../components/ConfirmedPortfolio.jsx'
import ReviewsSection from '../../components/ReviewsSection.jsx'
import EditProfileButton from '../../components/EditProfileButton.jsx'

const { slug } = Astro.params
const supabase = Astro.locals.supabase

// Only active profiles are public — hidden/unclaimed ones must not be
// reachable or indexable.
const { data: item } = await supabase
  .from('providers').select('*').eq('slug', slug).eq('status', 'active').maybeSingle()

// Genuine 404 rather than a redirect to the directory, which Google treats
// as a soft 404.
if (!item) return Astro.rewrite('/404')

const name = item.name || ''
const phone = item.whatsapp || item.phone
const altPhone = null
const city = item.city || item.district
const gallery: string[] = item.gallery || []
const services: string[] = item.services || []
const serviceAreas: string[] = item.service_areas || []
const firstName = (name || '').split(' ')[0]

function waLink(p: string, n: string, intent?: string) {
  const digits = (p || '').replace(/\D/g, '')
  const normalized = digits.startsWith('94') ? digits : '94' + digits.replace(/^0/, '')
  const who = n ? `*${n}*` : 'ඔබව'
  const msg = intent === 'visit'
    ? encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *වැඩHUB* (tilershub.lk) හරහා ${who} සොයාගතිමි.\n\nSite visit / consultation එකක් book කිරීමට කැමැත්තෙමි.\n\n📌 *වැඩHUB.lk* Lead\nස්තූතියි! 🏠`)
    : encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *වැඩHUB* (tilershub.lk) හරහා ${who} සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *වැඩHUB.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${normalized}?text=${msg}`
}

const PROVIDER_TYPE_LABELS: Record<string,string> = {
  tiler: 'ටයිල් ශිල්පී', contractor: 'කොන්ත්‍රාත්කරු', electrician: 'විදුලි ශිල්පී',
  plumber: 'ජලනල කාර්මික', carpenter: 'ලී ශිල්පී', painter: 'පින්තාරු ශිල්පී',
  mason: 'ගල් ශිල්පී', construction_company: 'ඉදිකිරීම් සමාගම',
  interior_designer: 'අභ්‍යන්තර සැලසුම්කරු', workshop: 'වැඩ පොළ',
  supplier: 'සැපයුම්කරු', tile_shop: 'ටයිල් සාප්පුව',
  brand_dealer: 'බ්‍රෑන්ඩ් නියෝජිතයා', bathroom_shop: 'නාන කාමර සාප්පුව',
  tool_supplier: 'මෙවලම් සැපයුම්කරු',
}
const typeLabel = PROVIDER_TYPE_LABELS[item.provider_type] || 'සේවා සපයන්නා'

// Tagline: short descriptor below the name
function getTagline(): string {
  const pt = item.provider_type || ''
  const svc = services.join(' ').toLowerCase()
  if (pt === 'contractor') {
    if (svc.includes('bathroom') || svc.includes('renovation')) return 'Bathroom Renovation & Construction'
    return 'Building & Construction'
  }
  if (pt === 'construction_company') return 'Construction Company'
  if (pt === 'tile_shop' || pt === 'bathroom_shop') return 'ටයිල් සහ නාන කාමර'
  if (pt === 'workshop') return 'Tile Cutting & Workshop'
  if (pt === 'supplier') return 'Tile & Material Supplier'
  if (pt === 'brand_dealer') return 'Authorized Brand Dealer'
  if (pt === 'tiler') return 'ටයිලිං සේවා'
  if (pt === 'electrician') return 'Electrical Works'
  if (pt === 'plumber') return 'Plumbing Services'
  if (pt === 'carpenter') return 'Carpentry Services'
  if (pt === 'painter') return 'Painting Services'
  if (pt === 'mason') return 'Masonry & Brickwork'
  if (pt === 'interior_designer') return 'Interior Design'
  return typeLabel
}
const tagline = getTagline()

// Cover image: use cover_image, else profile_image, else gallery[0]
const heroCoverSrc = item.cover_image || item.profile_image || gallery[0] || null

// Verification
function verBadge(vs: string | null) {
  if (vs === 'th_master')         return { label: 'TH Master ★',      bg: '#2A2F35', color: '#F3E7DF' }
  if (vs === 'th_certified_pro')  return { label: 'Certified Pro ✦',  bg: '#C2542B', color: '#E7D9CE' }
  if (vs === 'th_verified' || vs === 'verified') return { label: '✓ Verified', bg: 'rgba(22,163,74,0.92)', color: '#fff' }
  return null
}
const badge = verBadge(item.verification_status)

const isVerified = badge !== null
const verificationLabel = badge?.label || 'Listed'

// Serving area string
const servingText = serviceAreas.length > 0
  ? `${sinhalaText(serviceAreas[0])}${serviceAreas.length > 1 ? ' සහ අවට ප්‍රදේශවල' : ' හි'} සේවය සපයයි`
  : (city ? `${sinhalaText(city)} හි සේවය සපයයි` : null)

// Service icons map
const SERVICE_ICONS: Record<string,string> = {
  'Bathroom Renovation': '🛁',
  'Full Bathroom Design & Build': '📐',
  'New Bathroom Construction': '🏗️',
  'Shower Cubicle': '🚿',
  'Vanity Cupboard': '🪵',
  'Vanity & Cabinets': '🪵',
  'Waterproofing': '💧',
  'Bathroom Tiling': '🔲',
  'Floor Tiling': '🪨',
  'Wall Tiling': '🧱',
  'Bathroom Plumbing': '🔩',
  'Plumbing Works': '🔩',
  'Bathroom Lighting': '💡',
  'Ceiling & Lighting': '💡',
  'Bathroom Wiring': '⚡',
  'Electrical Works': '⚡',
  'Ipanel Ceiling': '🏗️',
  'Hand Railing': '🚧',
  'Tile Supply & Installation': '🪨',
  'Tile Cutting': '✂️',
  'Tile Routing': '🔧',
  'Granite Works': '💎',
  'Glass Works': '🪟',
  'Shower Cubicles': '🚿',
  'Bathroom Accessories': '🔲',
  'Bathroom Renovation Service': '🛁',
  'Kitchen Tiling': '🍳',
  'Staircase Tiling': '🪜',
  'Outdoor Tiling': '🌿',
  'Large Tile Installation': '📐',
  'Grouting & Finishing': '✨',
  'Large Floor Tiling': '📐',
  'Tile Router': '🔧',
}

// Why Choose bullets
const WHY_BULLETS: Record<string,string[]> = {
  contractor: [
    'Specialized Bathroom Experts',
    'Full Design & Build Service',
    'Premium Quality Materials',
    'Transparent Quotations',
  ],
  tiler: [
    'Verified Tiling Professional',
    'Years of On-Site Experience',
    'Direct WhatsApp Contact',
    'Competitive Day Rates',
  ],
  tile_shop: [
    'Wide Selection of Tile Brands',
    'Trade & Retail Pricing',
    'Expert Product Guidance',
    'Island-Wide Delivery',
  ],
  bathroom_shop: [
    'Complete Bathroom Solutions',
    'Premium Sanitary Fittings',
    'Expert Product Guidance',
    'Residential & Commercial',
  ],
  workshop: [
    'Precision Cutting Equipment',
    'Fast Turnaround',
    'Custom Tile Work',
    'Trade & Retail Orders',
  ],
  supplier: [
    'Bulk & Retail Supply',
    'Trade Pricing Available',
    'Island-Wide Delivery',
    'Quality Assured Products',
  ],
  default: [
    'TH Verified Professional',
    'Direct Contact — No Middlemen',
    'Serving Across Sri Lanka',
  ],
}
const whyBullets = isVerified
  ? (WHY_BULLETS[item.provider_type || 'default'] || WHY_BULLETS.default)
  : []

// Layout type determines which profile template to render
const PROFESSIONAL_TYPES_SET = new Set(['tiler','electrician','plumber','carpenter','painter','mason','interior_designer'])
const SHOP_TYPES_SET = new Set(['tile_shop','supplier','workshop','brand_dealer','bathroom_shop','tool_supplier'])
const layoutType = PROFESSIONAL_TYPES_SET.has(item.provider_type) ? 'professional'
  : SHOP_TYPES_SET.has(item.provider_type) ? 'shop'
  : 'contractor'

const TYPE_FEATURES_MAP: Record<string,{icon:string,label:string}[]> = {
  tile_shop:     [{icon:'🔲',label:'Wide Variety'},{icon:'💎',label:'Premium Quality'},{icon:'💰',label:'Best Prices'},{icon:'🚚',label:'Quick Supply'}],
  bathroom_shop: [{icon:'🛁',label:'Complete Range'},{icon:'✦',label:'Premium Brands'},{icon:'🎯',label:'Expert Guidance'},{icon:'✅',label:'Quality Assured'}],
  supplier:      [{icon:'📦',label:'Bulk Supply'},{icon:'💰',label:'Trade Pricing'},{icon:'🚚',label:'Fast Delivery'},{icon:'✅',label:'Quality Assured'}],
  workshop:      [{icon:'✂️',label:'Precision Cut'},{icon:'⚡',label:'Fast Turnaround'},{icon:'🔧',label:'Custom Orders'},{icon:'🏷️',label:'Trade Ready'}],
  brand_dealer:  [{icon:'✦',label:'Authentic'},{icon:'🛡️',label:'Warranty Backed'},{icon:'💡',label:'Expert Guidance'},{icon:'🚚',label:'Island Wide'}],
  tool_supplier: [{icon:'🔧',label:'Pro Equipment'},{icon:'🏷️',label:'Trade Pricing'},{icon:'📦',label:'In Stock'},{icon:'🚚',label:'Fast Delivery'}],
}
const shopFeatures: {icon:string,label:string}[] = TYPE_FEATURES_MAP[item.provider_type] || []

// Shop visit-intent WhatsApp message
const shopVisitLink = phone ? waLink(phone, name, 'visit') : null

// Initials for avatar fallback
function initials(n: string) {
  return n.split(' ').slice(0,2).map((w:string) => w[0]||'').join('').toUpperCase() || '?'
}
const AVATAR_COLORS = ['#C2542B','#C2542B','#8E3C1E','#C2542B','#2F6B4F','#C2542B','#285C43']
function avatarColor(n: string) {
  let h = 0; for (const c of n) h = (h*31+c.charCodeAt(0))>>>0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
const avatarBg = avatarColor(name || 'T')
const avatarSrc = item.profile_image || item.avatar_url

const avgRating = Number(item.avg_rating || 0)
const reviewCount = Number(item.review_count || 0)
const expYears = Number(item.experience_years || 0)

const isUnverified = !badge

const topServices = services.slice(0, 3).join(', ')
const metaDesc = isUnverified
  ? `${name} is a ${typeLabel.toLowerCase()} in ${city}, Sri Lanka.${topServices ? ' Services: ' + topServices + '.' : ''} Find contact details on වැඩHUB.`
  : `Contact ${name}, a verified ${typeLabel.toLowerCase()} in ${city}, Sri Lanka.${topServices ? ' Services: ' + topServices + '.' : ''} Direct WhatsApp on වැඩHUB.`

const schemaType = item.provider_type === 'tile_shop' || item.provider_type === 'bathroom_shop'
  ? 'HomeGoodsStore'
  : 'LocalBusiness'

const ogImageUrl = heroCoverSrc || avatarSrc || 'https://wedahub.lk/og.png'

const bizSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name,
  description: metaDesc,
  url: `https://wedahub.lk/providers/${slug}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: city,
    addressRegion: item.district || city,
    addressCountry: 'LK',
  },
  areaServed: item.district || city,
}
if (phone) bizSchema.telephone = phone
if (avatarSrc || heroCoverSrc) bizSchema.image = avatarSrc || heroCoverSrc
if (services.length > 0) bizSchema.knowsAbout = services
if (avgRating > 0 && reviewCount > 0) {
  bizSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: avgRating.toFixed(1),
    reviewCount,
    bestRating: '5',
    worstRating: '1',
  }
}

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wedahub.lk/' },
    { '@type': 'ListItem', position: 2, name: 'Providers', item: 'https://wedahub.lk/providers' },
    { '@type': 'ListItem', position: 3, name, item: `https://wedahub.lk/providers/${slug}` },
  ],
})
---

<Layout
  title={sinhalaText(`${name} · ${sinhalaText(city)} හි ${typeLabel} · වැඩHUB`)}
  description={sinhalaText(metaDesc)}
  ogImage={ogImageUrl}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(bizSchema)} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <!-- ════════════════════════════════════════════════════════════
       LAYOUT A — PROFESSIONAL (individual tiler)
  ════════════════════════════════════════════════════════════ -->
  {layoutType === 'professional' && (
    <div>
      <!-- Hero: 220px, personal feel -->
      <div style="position:relative;height:220px;overflow:hidden;background:#14171A;">
        {heroCoverSrc
          ? <img src={heroCoverSrc} alt={sinhalaText(name)} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
          : <div style="position:absolute;inset:0;background-image:repeating-linear-gradient(0deg,transparent,transparent 29px,rgba(255,255,255,0.06) 29px,rgba(255,255,255,0.06) 30px),repeating-linear-gradient(90deg,transparent,transparent 29px,rgba(255,255,255,0.06) 29px,rgba(255,255,255,0.06) 30px);pointer-events:none;"></div>
        }
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.88) 0%,rgba(0,0,0,0.45) 50%,rgba(0,0,0,0.12) 100%);"></div>
        <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#25D366,#2F6B4F);"></div>
        <div style="position:absolute;top:14px;left:16px;">
          <a href="/providers" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:rgba(255,255,255,0.75);font-weight:600;text-decoration:none;background:rgba(0,0,0,0.3);padding:5px 10px;border-radius:20px;backdrop-filter:blur(6px);">← ආපසු</a>
        </div>
        <div style="position:absolute;bottom:0;left:0;right:0;padding:14px 16px 18px;">
          {badge && (
            <div style="margin-bottom:8px;">
              <span style={`display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;background:${badge.bg};color:${badge.color};`}>{sinhalaText(badge.label)}</span>
            </div>
          )}
          <div style="display:flex;align-items:flex-end;gap:12px;">
            <div style={`width:64px;height:64px;border-radius:50%;background:${avatarBg};border:2.5px solid rgba(37,211,102,0.7);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#fff;flex-shrink:0;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,0.35);`}>
              {avatarSrc ? <img src={avatarSrc} alt={sinhalaText(name)} style="width:100%;height:100%;object-fit:cover;" /> : initials(name)}
            </div>
            <div style="flex:1;min-width:0;">
              <h1 style="font-family: var(--th-display);font-size:clamp(19px,5vw,26px);font-weight:700;color:#fff;margin:0 0 3px;line-height:1.2;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{sinhalaText(name)}</h1>
              <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-bottom:4px;">📍 {sinhalaText(city)}{sinhalaText(item.district && item.district !== item.city ? `, ${item.district}` : '')}</div>
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                {avgRating > 0 && <span style="font-size:11px;color:rgba(255,255,255,0.85);font-weight:600;">⭐ {sinhalaText(avgRating.toFixed(1))}{sinhalaText(reviewCount > 0 ? ` (${reviewCount})` : '')}</span>}
                {expYears > 0 && <span style="font-size:11px;color:rgba(255,255,255,0.6);">· {sinhalaText(expYears)}+ වසරක පළපුරුද්ද</span>}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA: WhatsApp only -->
      {phone && (
        <div style="background:#fff;padding:14px 16px;border-bottom:1px solid #E4E0D9;">
          <a href={waLink(phone, name)} target="_blank" rel="noopener noreferrer"
            style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#25D366;color:#fff;border-radius:14px;padding:14px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 12px rgba(37,211,102,0.3);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp {sinhalaText(firstName)}
          </a>
        </div>
      )}

      <!-- Stats: experience | daily rate | rating -->
      {(expYears > 0 || item.daily_rate_min || avgRating > 0) && (
        <div style="background:#FBFAF8;border-bottom:1px solid #E4E0D9;padding:14px 16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(72px,1fr));gap:4px;text-align:center;">
          {expYears > 0 && (
            <div style="padding:8px 4px;">
              <div style="font-size:18px;font-weight:800;color:#14171A;font-family: var(--th-display);line-height:1;">{sinhalaText(expYears)}+</div>
              <div style="font-size:9px;color:#6B7076;margin-top:3px;line-height:1.3;">වසර<br/>පළපුරුද්ද</div>
            </div>
          )}
          {item.daily_rate_min && (
            <div style="padding:8px 4px;">
              <div style="font-size:13px;font-weight:800;color:#14171A;font-family: var(--th-display);line-height:1;">රු.{sinhalaText(item.daily_rate_min)}{sinhalaText(item.daily_rate_max ? `–${item.daily_rate_max}` : '+')}</div>
              <div style="font-size:9px;color:#6B7076;margin-top:3px;line-height:1.3;">එකකට<br/>වර්ග අඩි</div>
            </div>
          )}
          {avgRating > 0 && (
            <div style="padding:8px 4px;">
              <div style="font-size:18px;font-weight:800;color:#14171A;font-family: var(--th-display);line-height:1;">{sinhalaText(avgRating.toFixed(1))}</div>
              <div style="font-size:9px;color:#6B7076;margin-top:3px;line-height:1.3;">ඇගයීම<br/>{sinhalaText(reviewCount > 0 ? `සමාලෝචන ${reviewCount}` : '')}</div>
            </div>
          )}
        </div>
      )}

      {isUnverified && (
        <div style="background:#fef9f0;border-bottom:1px solid #E7D9CE;padding:12px 16px;font-size:12px;color:#78716c;line-height:1.7;">
