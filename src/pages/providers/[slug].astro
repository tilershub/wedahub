        </div>
      )}

      <!-- Services -->
      {services.length > 0 && (
        <section style="background:#FBFAF8;padding:20px 16px 24px;border-bottom:1px solid #EFEBE4;">
          <h2 style="font-size:15px;font-weight:700;color:#14171A;margin:0 0 14px;">ශිල්ප සේවාවන්</h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            {services.map((s: string) => (
              <div style="display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #E4E0D9;border-radius:12px;padding:11px 12px;">
                <span style="font-size:20px;flex-shrink:0;">{sinhalaText(SERVICE_ICONS[s] || '🔧')}</span>
                <span style="font-size:11px;font-weight:600;color:#3A4046;line-height:1.3;">{sinhalaText(s)}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Bio -->
      {item.description && (
        <section style="background:#fff;padding:20px 16px 24px;border-bottom:1px solid #EFEBE4;">
          <h2 style="font-size:15px;font-weight:700;color:#14171A;margin:0 0 10px;">ගැන {sinhalaText(name)}</h2>
          <p style="font-size:13px;color:#6B7076;line-height:1.8;margin:0;">{sinhalaText(item.description)}</p>
        </section>
      )}

      <!-- Portfolio: "My Work" gallery -->
      {gallery.length > 0 && (
        <section id="gallery-section" style="background:#fff;padding:20px 0 24px;border-bottom:1px solid #EFEBE4;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0 16px 12px;">
            <span style="font-size:15px;font-weight:700;color:#14171A;">📸 මගේ වැඩ</span>
            <button id="all-photos-btn" style="font-size:12px;font-weight:600;color:#C2542B;background:none;border:none;cursor:pointer;padding:0;">සියල්ල බලන්න →</button>
          </div>
          <div style="display:flex;gap:12px;overflow-x:auto;padding:0 16px 4px;scrollbar-width:none;-webkit-overflow-scrolling:touch;">
            {gallery.map((img: string, i: number) => (
              <div style="flex-shrink:0;width:160px;height:200px;border-radius:16px;overflow:hidden;position:relative;box-shadow:0 4px 14px rgba(0,0,0,0.12);">
                <img src={img} alt={sinhalaText(`වැඩ ඡායාරූපය ${i + 1}`)} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.5) 0%,transparent 50%);"></div>
                <span style="position:absolute;bottom:8px;left:10px;font-size:9px;color:#fff;font-weight:600;">📍 {sinhalaText(city)}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Experience stats -->
      {(item.total_jobs > 0 || item.daily_rate_min) && (
        <section style="background:#fff;padding:20px 16px 24px;border-bottom:1px solid #EFEBE4;">
          <h2 style="font-size:15px;font-weight:700;color:#14171A;margin:0 0 12px;">අත්දැකීම</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;">
            {item.total_jobs > 0 && (
              <div style="flex:1;min-width:80px;padding:14px;background:#FBFAF8;border:1px solid #E4E0D9;border-radius:14px;text-align:center;">
                <div style="font-size:22px;font-weight:800;color:#14171A;font-family: var(--th-display);">{sinhalaText(item.total_jobs)}</div>
                <div style="font-size:10px;color:#6B7076;margin-top:3px;">සේවා ගණන</div>
              </div>
            )}
            {item.daily_rate_min && (
              <div style="flex:1;min-width:80px;padding:14px;background:#FBFAF8;border:1px solid #E4E0D9;border-radius:14px;text-align:center;">
                <div style="font-size:14px;font-weight:800;color:#14171A;font-family: var(--th-display);">රු.{sinhalaText(item.daily_rate_min)}–{sinhalaText(item.daily_rate_max)}/වර්ග අඩි</div>
                <div style="font-size:10px;color:#6B7076;margin-top:3px;">ගාස්තු (sq.ft ට)</div>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Reviews -->
      <section style="background:#fff;padding:20px 0 8px;">
        <ConfirmedPortfolio client:load providerId={item.id} />
        <ReviewsSection client:load providerId={item.id} />
      </section>

      <!-- Bottom CTA -->
      {phone && (
        <section style="background:#FBFAF8;border-top:1px solid #E4E0D9;padding:16px;display:flex;gap:8px;flex-wrap:wrap;">
          <a href={waLink(phone, name)} target="_blank" rel="noopener noreferrer"
            style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#25D366;color:#fff;border-radius:12px;padding:12px 10px;font-size:12px;font-weight:700;text-decoration:none;">
            💬 WhatsApp
          </a>
          {gallery.length > 0 && (
            <a href="#gallery-section"
              style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#14171A;color:#fff;border-radius:12px;padding:12px 10px;font-size:12px;font-weight:700;text-decoration:none;">
              📷 කළ වැඩ බලන්න
            </a>
          )}
        </section>
      )}
    </div>
  )}

  <!-- ════════════════════════════════════════════════════════════
       LAYOUT B — CONTRACTOR
  ════════════════════════════════════════════════════════════ -->
  {layoutType === 'contractor' && (
    <div>
      <!-- Hero: 300px full-bleed -->
      <div style="position:relative;height:300px;overflow:hidden;background:#14171A;">
        {heroCoverSrc
          ? <img src={heroCoverSrc} alt={sinhalaText(name)} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
          : <div style="position:absolute;inset:0;background-image:repeating-linear-gradient(0deg,transparent,transparent 29px,rgba(255,255,255,0.06) 29px,rgba(255,255,255,0.06) 30px),repeating-linear-gradient(90deg,transparent,transparent 29px,rgba(255,255,255,0.06) 29px,rgba(255,255,255,0.06) 30px);pointer-events:none;"></div>
        }
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.92) 0%,rgba(0,0,0,0.5) 50%,rgba(0,0,0,0.15) 100%);"></div>
        <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#E08A5F,#f0c94d);"></div>
        <div style="position:absolute;top:16px;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:0 16px;">
          <a href="/providers" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:rgba(255,255,255,0.75);font-weight:600;text-decoration:none;background:rgba(0,0,0,0.3);padding:5px 10px;border-radius:20px;backdrop-filter:blur(6px);">← සියලු සේවා සපයන්නන්</a>
          {gallery.length > 0 && (
            <button id="view-photos-btn" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#fff;font-weight:600;background:rgba(0,0,0,0.35);padding:5px 10px;border-radius:20px;border:none;cursor:pointer;backdrop-filter:blur(6px);">📷 ඡායාරූප බලන්න ({sinhalaText(gallery.length)})</button>
          )}
        </div>
        <div style="position:absolute;bottom:0;left:0;right:0;padding:16px 16px 20px;">
          {badge && (
            <div style="margin-bottom:10px;">
              <span style={`display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:700;padding:4px 10px;border-radius:20px;background:${badge.bg};color:${badge.color};letter-spacing:0.3px;`}>{sinhalaText(badge.label)}</span>
            </div>
          )}
          <div style="display:flex;align-items:flex-end;gap:14px;">
            <div style={`width:72px;height:72px;border-radius:50%;background:${avatarBg};border:2.5px solid rgba(96,165,250,0.7);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;color:#fff;flex-shrink:0;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.4);`}>
              {avatarSrc ? <img src={avatarSrc} alt={sinhalaText(name)} style="width:100%;height:100%;object-fit:cover;" /> : initials(name)}
            </div>
            <div style="flex:1;min-width:0;">
              <h1 style="font-family: var(--th-display);font-size:clamp(20px,5vw,28px);font-weight:700;color:#fff;margin:0 0 3px;line-height:1.2;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{sinhalaText(name)}</h1>
              <div style="font-size:12px;color:rgba(255,255,255,0.7);margin-bottom:5px;font-weight:500;">{sinhalaText(tagline)}</div>
              {servingText && <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-bottom:5px;">📍 {sinhalaText(servingText)}</div>}
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                {avgRating > 0 && <span style="font-size:11px;color:rgba(255,255,255,0.85);font-weight:600;">⭐ {sinhalaText(avgRating.toFixed(1))}{sinhalaText(reviewCount > 0 ? ` (සමාලෝචන ${reviewCount})` : '')}</span>}
                {expYears > 0 && <span style="font-size:11px;color:rgba(255,255,255,0.65);">· {sinhalaText(expYears)}+ වසරක පළපුරුද්ද</span>}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA: WhatsApp + Book a Site Visit -->
      {phone && (
        <div style="background:#fff;padding:14px 16px;display:flex;gap:10px;border-bottom:1px solid #E4E0D9;">
          <a href={waLink(phone, name)} target="_blank" rel="noopener noreferrer"
            style="flex:1;display:flex;align-items:center;justify-content:center;gap:7px;background:#25D366;color:#fff;border-radius:14px;padding:13px 10px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 12px rgba(37,211,102,0.3);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp {sinhalaText(firstName)}
          </a>
          <a href={waLink(phone, name, 'visit')} target="_blank" rel="noopener noreferrer"
            style="flex:1;display:flex;align-items:center;justify-content:center;gap:7px;background:#14171A;color:#fff;border-radius:14px;padding:13px 10px;font-size:13px;font-weight:700;text-decoration:none;">
            📅 ස්ථාන පරීක්ෂාවක් වෙන්කරගන්න
