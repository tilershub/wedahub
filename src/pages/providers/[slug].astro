---
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import ReviewsSection from '../../components/ReviewsSection.jsx'
import ConfirmedPortfolio from '../../components/ConfirmedPortfolio.jsx'
import EditProfileButton from '../../components/EditProfileButton.jsx'
import { professionLabel, RETAIL_TYPES } from '../../lib/professions.js'
const { data: item } = await Astro.locals.supabase.from('providers').select('*').eq('slug',Astro.params.slug).eq('status','active').maybeSingle()
if (!item) return Astro.rewrite('/404')
if (RETAIL_TYPES.includes(item.provider_type)) return Astro.redirect('/providers',301)
const phone = (item.whatsapp || item.phone || '').replace(/\D/g,'')
const normalized = phone.startsWith('0') ? '94'+phone.slice(1) : phone
const wa = `https://wa.me/${normalized}?text=${encodeURIComponent(`Hello ${item.name}, I found your services on WedaHUB (wedahub.lk). I would like to discuss a job.`)}`
const verified = ['th_verified','th_certified_pro','th_master'].includes(item.verification_status)
const label = professionLabel(item.provider_type,'si')
---
<Layout title={`${item.name} · ${label} · වැඩHUB`} description={`${item.name}: ${(item.services || []).join(', ')}. Serving ${item.city || item.district || 'Sri Lanka'}. View services, work and job-linked reviews.`} ogImage={item.profile_image || 'https://wedahub.lk/og.png'}>
  <div class="wh-container">
    <a href="/providers" style="display:inline-block;margin-bottom:18px;color:var(--navy);font-size:13px">← සේවා සපයන්නන්</a>
    <header class="wh-profile-head">{item.profile_image ? <img class="wh-avatar" src={item.profile_image} alt={item.name}/> : <span class="wh-avatar">{item.name.slice(0,1)}</span>}<div><h1>{item.name}</h1><p>{label} · {item.city || item.district}</p><p>{verified ? '✓ සත්‍යාපිත පැතිකඩ' : 'ලැයිස්තුගත සේවා සපයන්නා'}</p></div></header>
    <div class="wh-profile-columns"><div>
      <section class="wh-panel"><h2>සේවාව ගැන</h2><p style="white-space:pre-line">{item.description || 'වැඩි විස්තර සඳහා සේවා සපයන්නා සමඟ සම්බන්ධ වන්න.'}</p><div class="wh-chips">{(item.services || []).map(s=><span>{s}</span>)}</div>{item.experience_years > 0 && <p>පළපුරුද්ද: වසර {item.experience_years}</p>}</section>
      {item.gallery?.length > 0 && <section class="wh-panel"><h2>වැඩ සහ හැකියාවන්</h2><div class="wh-gallery">{item.gallery.map((src,i)=><a href={src} target="_blank" rel="noopener noreferrer"><img src={src} alt={`${item.name} — work example ${i+1}`} loading="lazy"/></a>)}</div></section>}
      <ConfirmedPortfolio client:load providerId={item.id}/>
      <ReviewsSection client:load providerId={item.id}/>
    </div><aside class="wh-profile-sidebar"><section class="wh-panel"><h2>සෘජුව සම්බන්ධ වන්න</h2><p>අවශ්‍යතාව, කාලය සහ මිල ගැන සේවා සපයන්නා සමඟ කතා කරන්න.</p>{normalized && <a class="wh-button" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp මඟින් කතා කරන්න</a>}{item.phone && <a class="wh-button secondary" href={`tel:${item.phone.replace(/[^+\d]/g,'')}`}>දුරකථන ඇමතුමක්</a>}<a class="wh-button secondary" href="/my-jobs">වැඩයක් තහවුරු කරන්න</a></section><section class="wh-panel"><h2>සේවා සපයන ප්‍රදේශ</h2><p>{(item.service_areas?.length ? item.service_areas : [item.city || item.district || 'විමසන්න']).join(' · ')}</p></section><EditProfileButton client:load ownerId={item.user_id} profileType="provider" profileSlug={item.slug}/></aside></div>
  </div>
</Layout>
