---
import { si as sinhalaText } from '../lib/sinhala.js'
import Layout from '../layouts/Layout.astro'

const supabase = Astro.locals.supabase

const { data: allBrands } = await supabase
  .from('brands').select('*').eq('status', 'active')
  .order('is_featured', { ascending: false }).order('name')
const brands = allBrands || []

// All active brands in one carousel

const { data: shopData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'tile_shop')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })
const shops = shopData || []

// Verified tilers for interleaving into shop list
const { data: tilerData } = await supabase
  .from('tilers')
  .select('id,full_name,slug,city,district,services,experience_years,phone,whatsapp')
  .eq('is_verified', true)
  .not('slug', 'is', null)
  .order('experience_years', { ascending: false })
  .limit(12)
const verifiedTilers = tilerData || []

function normPhone(phone) {
  const raw = (phone || '').replace(/\D/g, '')
  return raw.startsWith('94') ? raw : '94' + raw.replace(/^0/, '')
}
function initials(name) {
  return (name || '').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
}

// Build interleaved list: insert a verified tiler card after every 5th shop
const interleaved = []
let tilerIdx = 0
shops.forEach((shop, i) => {
  interleaved.push({
    type: 'shop',
    id: shop.id,
    name: shop.name,
    city: shop.city,
    district: shop.district,
    description: shop.description,
    services: shop.services || [],
    waLink: (shop.whatsapp || shop.phone)
      ? `https://wa.me/${normPhone(shop.whatsapp || shop.phone)}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම වැඩHUB හරහා ${shop.name} සොයාගතිමි.\nස්තූතියි!`)}`
      : null,
    phone: shop.phone,
    isFeatured: shop.is_featured,
  })
  if ((i + 1) % 5 === 0 && tilerIdx < verifiedTilers.length) {
    const t = verifiedTilers[tilerIdx++]
    interleaved.push({
      type: 'tiler',
      id: t.id,
      name: t.full_name,
      slug: t.slug,
      city: t.city,
      district: t.district,
      services: t.services || [],
      experience_years: t.experience_years,
      initials: initials(t.full_name),
      waLink: `https://wa.me/${normPhone(t.whatsapp || t.phone)}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම වැඩHUB හරහා ${t.full_name} සොයාගතිමි.\nTiling සේවාව ගැන කතා කිරීමට කැමැත්තෙමි.\nස්තූතියි!`)}`,
    })
  }
})

const BRAND_META = {
  'rocell':      { color: '#FFFFFF', bg: '#002B5B' },
  'lanka-tile':  { color: '#FFFFFF', bg: '#CC2229' },
  'macktiles':   { color: '#FFFFFF', bg: '#2F6B4F' },
  'megatile':    { color: '#FFFFFF', bg: '#4A4A4A' },
  'swisstek':    { color: '#FFFFFF', bg: '#1565C0' },
  'tokyo-super': { color: '#FFFFFF', bg: '#C0392B' },
  'dr-fixit':    { color: '#FFFFFF', bg: '#8A6224' },
  'sika':        { color: '#FFFFFF', bg: '#B71C1C' },
  'finex':       { color: '#FFFFFF', bg: '#1A237E' },
}
function meta(brand) { return BRAND_META[brand.slug] || { color: '#fff', bg: '#8A6224' } }
function logoText(name) { return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() }
import { brandHref, sponsorPage } from '../lib/sponsors.js'
---

<Layout
  title="ශ්‍රී ලංකාවේ ටයිල් වෙළෙඳසැල්, සන්නාම සහ ඇලවුම් ද්‍රව්‍ය · වැඩHUB"
  description="ශ්‍රී ලංකාවේ ටයිල් වෙළෙඳසැල්, Rocell, Lanka Tile, Megatile සන්නාම, Swisstek සහ Tokyo Super ඇලවුම් ද්‍රව්‍ය සහ සත්‍යාපිත ටයිල් විශේෂඥයන් සොයන්න."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#0B0B0B,#1F2429,#242424);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(212,161,94,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">🪨 ටයිල්</span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        ටයිල් සහ වෙළෙඳසැල් <span style="color:var(--terra);">සහ සන්නාම</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto 28px;line-height:1.8;">
        ශ්‍රී ලංකාවේ ටයිල් වෙළෙඳසැල්, ප්‍රමුඛ සන්නාම, ඇලවුම් ද්‍රව්‍ය සහ ග්‍රවුට් බලා විශේෂඥ කාර්මිකයන් සමඟ සම්බන්ධ වන්න.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:#8A6224;color:#fff;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🪨 ඔබේ ටයිල් වෙළෙඳසැල එක් කරන්න
        </a>
        <a href="/providers" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          👷 ටයිල් කාර්මිකයෙකු සොයන්න →
        </a>
      </div>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 0 64px;">
    <div style="max-width:1100px;margin:0 auto;padding:0 20px;">

      <!-- ── All Brands — horizontal scroll carousel ── -->
      {brands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:36px;height:36px;background:linear-gradient(135deg,var(--navy),#242424);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🪨</div>
              <div>
                <div style="font-size:18px;font-weight:700;color:var(--text);">සන්නාම</div>
                <div style="font-size:12px;color:var(--text-4);">ටයිල්, ඇලවුම් ද්‍රව්‍ය, ග්‍රවුට්, ජලරෝධක ද්‍රව්‍ය සහ තවත් දේ</div>
              </div>
            </div>
            <span style="font-size:11px;color:var(--text-4);white-space:nowrap;">← දෙපසට අදින්න →</span>
          </div>

          <div style="position:relative;">
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;padding:4px 0 14px;margin:0 -20px;padding-left:20px;padding-right:20px;" class="tile-brands-scroll">
              <div style="display:flex;gap:16px;width:max-content;">
                {brands.map(brand => {
                  const m = meta(brand)
                  const href = brandHref(brand)
                  const isFeaturedPage = !!sponsorPage(brand)
                  return (
                    <a href={href}
                      style={`display:block;width:240px;flex-shrink:0;background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #E2E2E2'};padding:20px;text-decoration:none;color:inherit;scroll-snap-align:start;position:relative;overflow:hidden;`}>
                      {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0B0B0B;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 10px;border-bottom-left-radius:10px;">අනුග්‍රාහක</div>}
                      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                        <div style={`width:52px;height:52px;border-radius:13px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                        <div>
                          <div style="font-size:15px;font-weight:700;color:var(--text);line-height:1.2;">{sinhalaText(brand.name)}</div>
                          {isFeaturedPage
                            ? <span style="font-size:10px;color:#8A6224;font-weight:700;">⭐ විශේෂාංගගත</span>
                            : brand.is_featured && <span style="font-size:10px;color:var(--navy);font-weight:700;">✓ සත්‍යාපිත</span>
                          }
                        </div>
                      </div>
                      <p style="font-size:11px;color:var(--text-3);line-height:1.6;margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(brand.description)}</p>
                      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px;">
                        {(brand.categories || []).slice(0, 2).map(c => (
                          <span style={`font-size:9px;padding:2px 8px;border-radius:20px;background:${m.bg}14;color:${m.bg === '#FFFFFF' ? '#8A6224' : m.bg};border:1px solid ${m.bg}28;font-weight:600;`}>{sinhalaText(c)}</span>
                        ))}
                      </div>
                      <div style="font-size:11px;font-weight:700;color:var(--navy);">{sinhalaText(isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →')}</div>
                    </a>
                  )
                })}
              </div>
            </div>
            <!-- Right fade hint -->
            <div style="position:absolute;top:0;right:0;width:48px;height:calc(100% - 14px);background:linear-gradient(to left,var(--surface),transparent);pointer-events:none;"></div>
          </div>
        </div>
      )}

      <!-- ── Tile Shops + Verified Tiler cards every 5 shops ── -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#2F6B4F,#1B5E20);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🏪</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">ටයිල් වෙළෙඳසැල්</div>
              <div style="font-size:12px;color:var(--text-4);">
                {sinhalaText(shops.length > 0 ? `දිවයින පුරා වෙළෙඳසැල් ${shops.length} ක් ලැයිස්තුගත කර ඇත` : 'Be the first to list your tile shop')}
              </div>
            </div>
          </div>
          <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            + ඔබේ වෙළෙඳසැල එක් කරන්න
          </a>
        </div>

        {shops.length > 0 ? (
          <div style="display:flex;flex-direction:column;gap:12px;max-width:740px;">
            {interleaved.map(item => item.type === 'tiler' ? (
              /* ── Verified Tiler interleave card ── */
              <div style="background:linear-gradient(135deg,#F5EEE2,#F2EADC);border-radius:18px;border:2px solid var(--navy);padding:16px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;position:relative;">
                <div style="position:absolute;top:0;left:0;background:var(--navy);color:#fff;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-right-radius:10px;border-top-left-radius:16px;">✓ දක්ෂතා සත්‍යාපිත ටයිල් කාර්මිකයා</div>
                <div style="padding-top:18px;display:flex;align-items:center;gap:14px;flex:1;min-width:220px;flex-wrap:wrap;">
                  <div style="width:52px;height:52px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:#fff;flex-shrink:0;border:3px solid var(--gold);">
                    {sinhalaText(item.initials)}
                  </div>
                  <div style="flex:1;min-width:140px;">
                    <div style="font-size:15px;font-weight:800;color:var(--text);">{sinhalaText(item.name)}</div>
                    {(item.city || item.district) && (
                      <div style="font-size:12px;color:var(--text-3);">📍 {sinhalaText(item.city)}{sinhalaText(item.district ? `, ${item.district}` : '')}</div>
                    )}
                    <div style="font-size:11px;color:#5E3F14;font-weight:700;margin-top:2px;">
                      {sinhalaText(item.experience_years ? `වසර ${item.experience_years}+ ක පළපුරුද්ද` : 'Skilled Tiler')}
                    </div>
                    {(item.services || []).length > 0 && (
                      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;">
                        {(item.services || []).slice(0, 3).map(sv => (
                          <span style="font-size:9px;padding:2px 7px;border-radius:20px;background:#F2EADC;color:#5E3F14;border:1px solid #E8DCC6;font-weight:600;">{sinhalaText(sv)}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
                <div style="display:flex;gap:7px;align-items:center;">
                  <a href={item.waLink} target="_blank" rel="noopener noreferrer"
                    style="display:inline-flex;align-items:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:9px 14px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
                    💬 WhatsApp
                  </a>
                  <a href={`/tilers/${item.slug}`}
                    style="display:inline-flex;align-items:center;gap:5px;background:var(--navy);color:#fff;border-radius:10px;padding:9px 14px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
                    පැතිකඩ බලන්න →
                  </a>
                </div>
              </div>
            ) : (
              /* ── Tile Shop card ── */
              <div style={`background:#fff;border-radius:16px;border:${item.isFeatured ? '2px solid var(--gold)' : '1px solid #E2E2E2'};padding:16px 20px;display:flex;align-items:flex-start;gap:14px;box-shadow:0 2px 8px rgba(0,0,0,0.04);`}>
                <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#2F6B4F,#1B5E20);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🏪</div>
                <div style="flex:1;min-width:0;">
                  <div style="font-size:15px;font-weight:800;color:var(--text);line-height:1.2;">{sinhalaText(item.name)}</div>
                  {(item.city || item.district) && (
                    <div style="font-size:12px;color:var(--text-3);margin-top:2px;">📍 {sinhalaText(item.city)}{sinhalaText(item.district ? `, ${item.district}` : '')}</div>
                  )}
                  {item.description && (
                    <p style="font-size:11px;color:var(--text-3);line-height:1.6;margin:6px 0 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(item.description)}</p>
                  )}
                  {(item.services || []).length > 0 && (
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;">
                      {(item.services || []).slice(0, 4).map(sv => (
                        <span style="font-size:9px;padding:2px 7px;border-radius:20px;background:#E9F1EC;color:#22513B;border:1px solid #C6DDCF;font-weight:600;">{sinhalaText(sv)}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
                  {item.waLink && (
                    <a href={item.waLink} target="_blank" rel="noopener noreferrer"
                      style="display:inline-flex;align-items:center;gap:5px;background:#25D366;color:#fff;border-radius:8px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;white-space:nowrap;">
                      💬 WhatsApp
                    </a>
                  )}
                </div>
              </div>
            ))}

            <!-- Always show a "list your shop" invite card -->
            <div style="background:#fff;border-radius:16px;border:2px dashed var(--border);padding:24px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
              <div style="font-size:32px;">🏪</div>
              <div style="flex:1;min-width:180px;">
                <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px;">ඔබේ ටයිල් වෙළෙඳසැල ලැයිස්තුගත කරන්න</div>
                <p style="font-size:12px;color:var(--text-3);line-height:1.6;margin:0;">ටයිල් ව්‍යාපෘති සැලසුම් කරන නිවාස හිමියන් සහ ඉදිකරන්නන් වෙත ළඟාවන්න — සම්පූර්ණයෙන් නොමිලේ.</p>
              </div>
              <a href="/join-wedahub" style="display:inline-flex;align-items:center;gap:6px;background:var(--navy);color:#fff;border-radius:10px;padding:9px 18px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
                + මගේ වෙළෙඳසැල නොමිලේ එක් කරන්න
              </a>
            </div>
          </div>
        ) : (
