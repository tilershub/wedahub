---
import { si as sinhalaText } from '../../lib/sinhala.js'
import Layout from '../../layouts/Layout.astro'

const { data: allBrands } = await Astro.locals.supabase.from('brands').select('*').eq('status', 'active').order('is_featured', { ascending: false }).order('name')
const brands = allBrands || []

const CHEMICAL_CATS = ['Tile Adhesive', 'Waterproofing', 'Construction Chemicals', 'Grout', 'Sealants']
const RENO_CATS = ['Bathroom Renovation', 'Interior Design', 'Construction', 'Premium Partner']
const BATHROOM_CATS = ['Sanitary Ware', 'Faucets', 'Bathroom Fittings', 'Bathroom Products', 'Showers', 'Bathtubs', 'Bathroom Accessories']

const isChemical = (b) => (b.categories || []).some(c => CHEMICAL_CATS.includes(c))
const isReno = (b) => (b.categories || []).some(c => RENO_CATS.includes(c))
const isBathroom = (b) => (b.categories || []).some(c => BATHROOM_CATS.includes(c))

const tileBrands = brands.filter(b => !isChemical(b) && !isReno(b) && !isBathroom(b))
const chemBrands = brands.filter(b => isChemical(b))
const renoBrands = brands.filter(b => isReno(b) && !isChemical(b))
const bathroomBrands = brands.filter(b => isBathroom(b) && !isChemical(b) && !isReno(b))

const BRAND_META = {
  'rocell':      { color: '#FFFFFF', bg: '#002B5B' },
  'lanka-tile':  { color: '#FFFFFF', bg: '#CC2229' },
  'macktiles':   { color: '#FFFFFF', bg: '#2F6B4F' },
  'megatile':    { color: '#FFFFFF', bg: '#4A4A4A' },
  'swisstek':    { color: '#FFFFFF', bg: '#1565C0' },
  'tokyo-super': { color: '#FFFFFF', bg: '#C0392B' },
  'dr-fixit':    { color: '#FFFFFF', bg: '#8A6224' },
  'sika':        { color: '#FFFFFF', bg: '#B71C1C' },
  'finex':       { color: '#FFFFFF', bg: '#1A237E' },
}

function meta(brand) {
  return BRAND_META[brand.slug] || { color: '#fff', bg: '#8A6224' }
}

function logoText(name) {
  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
}
import { brandHref, sponsorPage } from '../../lib/sponsors.js'
---

<Layout
  title="ශ්‍රී ලංකාවේ ටයිල් සහ ඉදිකිරීම් රසායනික සන්නාම · වැඩHUB"
  description="ශ්‍රී ලංකාවේ Rocell, Lanka Tile, Megatile, Swisstek, Sika ඇතුළු ටයිල්, ඇලවුම් ද්‍රව්‍ය සහ ජලරෝධන සන්නාම සොයන්න."
>

  <div style="background:var(--navy);padding:44px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">🏷️ සන්නාම</span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:12px 0 10px;line-height:1.2;">
        සන්නාම <span style="color:var(--terra);">ශ්‍රී ලංකාව</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);">ටයිල් සන්නාම, ඇලවුම් ද්‍රව්‍ය, ග්‍රවුට් සහ ජලරෝධන නිෂ්පාදන</p>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 20px 64px;">
    <div style="max-width:1100px;margin:0 auto;">

      <!-- ── Tile Brands ── -->
      {tileBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,var(--navy),#242424);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🪨</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">ටයිල් සන්නාම</div>
              <div style="font-size:12px;color:var(--text-4);">බිම් ටයිල්, බිත්ති ටයිල්, පෝසිලේන් සහ සෙරමික් එකතු</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {tileBrands.map(brand => {
              const m = meta(brand)
              const href = brandHref(brand)
              const isFeaturedPage = !!sponsorPage(brand)
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #E2E2E2'};padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(212,161,94,0.12)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0B0B0B;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">අනුග්‍රාහක</div>}
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{sinhalaText(brand.name)}</div>
                      {isFeaturedPage
                        ? <span style="font-size:10px;color:#8A6224;font-weight:700;">⭐ විශේෂාංගගත සන්නාමය</span>
                        : brand.is_featured && <span style="font-size:10px;color:var(--navy);font-weight:700;">✓ සත්‍යාපිත සන්නාමය</span>
                      }
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{sinhalaText(brand.description)}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style={`font-size:10px;padding:2px 9px;border-radius:20px;background:${m.bg}18;color:${m.bg === '#FFFFFF' ? '#8A6224' : m.bg};border:1px solid ${m.bg}30;font-weight:600;`}>{sinhalaText(c)}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">{sinhalaText(isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →')}</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Renovation & Design ── -->
      {renoBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#242424,#0B0B0B);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🛁</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">අලුත්වැඩියා සහ අභ්‍යන්තර සැලසුම්</div>
              <div style="font-size:12px;color:var(--text-4);">නානකාමර ඉදිකිරීම, අලුත්වැඩියා පැකේජ සහ අභ්‍යන්තර සැලසුම් සේවා</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {renoBrands.map(brand => {
              const m = meta(brand)
              const href = brandHref(brand)
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:2px solid var(--gold);padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(96,165,250,0.2)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0B0B0B;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">අනුග්‍රාහක</div>
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{sinhalaText(brand.name)}</div>
                      <span style="font-size:10px;color:#8A6224;font-weight:700;">⭐ විශේෂ හවුල්කරු</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{sinhalaText(brand.description)}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).filter(c => c !== 'Premium Partner').slice(0,3).map(c => (
                      <span style="font-size:10px;padding:2px 9px;border-radius:20px;background:#FFF8E1;color:#8A6224;border:1px solid #F5D97A;font-weight:600;">{sinhalaText(c)}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:#8A6224;">අනුග්‍රාහක පිටුව බලන්න →</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Bathroom Products ── -->
      {bathroomBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#0B0B0B,#8A6224);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🚿</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">නානකාමර නිෂ්පාදන සහ සවිකිරීම්</div>
              <div style="font-size:12px;color:var(--text-4);">සනීපාරක්ෂක උපකරණ, කරාම, ෂවර්, නාන බේසම් සහ නානකාමර උපාංග</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {bathroomBrands.map(brand => {
              const m = meta(brand)
              const href = brandHref(brand)
              const isFeaturedPage = !!sponsorPage(brand)
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #E2E2E2'};padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(212,161,94,0.12)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0B0B0B;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">අනුග්‍රාහක</div>}
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{sinhalaText(brand.name)}</div>
                      <span style="font-size:10px;color:#0B0B0B;font-weight:700;">🚿 නාන කාමර උපාංග</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{sinhalaText(brand.description)}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style="font-size:10px;padding:2px 9px;border-radius:20px;background:#F5EEE2;color:#8A6224;border:1px solid #E8DCC6;font-weight:600;">{sinhalaText(c)}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">{sinhalaText(isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →')}</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Adhesives & Waterproofing ── -->
      {chemBrands.length > 0 && (
        <div>
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#2F6B4F,#075985);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">💧</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">ඇලවුම් සහ ජලරෝධක ද්‍රව්‍ය</div>
              <div style="font-size:12px;color:var(--text-4);">ටයිල් ඇලවුම් ද්‍රව්‍ය, ග්‍රවුට්, ජලරෝධක ද්‍රව්‍ය සහ ඉදිකිරීම් රසායන</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {chemBrands.map(brand => {
              const m = meta(brand)
              return (
                <a href={`/brands/${brand.slug}`} style="background:#fff;border-radius:16px;border:1px solid #E2E2E2;padding:22px;display:block;text-decoration:none;color:inherit;transition:box-shadow 0.2s,transform 0.2s;"
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(212,161,94,0.10)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family: var(--th-display);`}>{sinhalaText(logoText(brand.name))}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{sinhalaText(brand.name)}</div>
                      <span style="font-size:10px;color:#2F6B4F;font-weight:700;">💧 ඉදිකිරීම් රසායනික ද්‍රව්‍ය</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{sinhalaText(brand.description)}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style={`font-size:10px;padding:2px 9px;border-radius:20px;background:${m.bg}18;color:${m.bg};border:1px solid ${m.bg}28;font-weight:600;`}>{sinhalaText(c)}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">සන්නාමය බලන්න →</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
