---
import { si as sinhalaText } from '../../lib/sinhala.js'
// /tilers/<district> → SSR district landing page ("Tilers in Colombo").
// Any other slug keeps the legacy behaviour: 301 to the provider profile.
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { districtBySlug, districtPath, serviceDistrictPath, neighborDistricts, LOCATION_SERVICE_SLUGS } from '../../lib/locations.js'
import { LABOUR, ADHESIVE_TIERS, EXTRAS, typicalCostPerSqft } from '../../lib/costData.js'
import { SERVICES } from '../../lib/services.js'
import { jobPath, timeAgo } from '../../lib/jobs.js'

const { slug } = Astro.params
const district = districtBySlug(slug)
if (!district) return Astro.redirect(`/providers/${slug}`, 301)

const supabase = Astro.locals.supabase

const [{ data: providersRaw }, { data: jobsRaw }] = await Promise.all([
  supabase
    .from('providers')
    .select('id,name,city,district,verification_status,slug,services,whatsapp,phone,description,profile_image,avg_rating,experience_years,cover_image,daily_rate_min,review_count,service_areas')
    .eq('status', 'active')
    .limit(200),
  supabase
    .from('projects')
    .select('id,project_type,city,district,created_at,budget_range,description')
    .eq('status', 'active')
    .eq('district', district.name)
    .order('created_at', { ascending: false })
    .limit(5),
])

const providers = (providersRaw || []).filter(p =>
  p.district === district.name ||
  (p.service_areas || []).includes(district.name) ||
  (p.city || '').toLowerCase().includes(district.name.toLowerCase())
).slice(0, 24)

const jobs = jobsRaw || []
const total = providers.length
const neighbors = neighborDistricts(district.slug)
// These pages are generated for every district (and every district × service
// pair), but the directory only fills them once real providers cover that
// area. An empty template is thin content: keep it reachable, keep it out of
// the index, and let it back in automatically once it has something to show.
const isThin = providers.length === 0 && jobs.length === 0
const locServices = LOCATION_SERVICE_SLUGS.map(s => SERVICES.find(x => x.slug === s)).filter(Boolean)
const cost = typicalCostPerSqft()
const year = new Date().getFullYear()
const districtLabel = district.nameSi || sinhalaText(district.name)
const townLabels = district.towns.map(sinhalaText)

const AVATAR_COLORS = ['#8A6224','#8A6224','#6B4A18','#8A6224','#2F6B4F','#8A6224','#285C43','#8A6224']
function avatarColor(name) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name) {
  return name.split(' ').slice(0, 2).map(w => w[0] || '').join('').toUpperCase() || '?'
}
function waLink(phone, name) {
  const cleaned = phone.replace(/\D/g, '')
  const intl = cleaned.startsWith('0') ? '94' + cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi, I found you on වැඩHUB. I'm looking for a tiler in ${district.name}.`)}`
}

const pageTitle = `${districtLabel} ටයිල් කාර්මිකයන් — සත්‍යාපිත වෘත්තිකයන් (${year}) | වැඩHUB`
const pageDesc = `${districtLabel} දිස්ත්‍රික්කයේ සත්‍යාපිත ටයිල් කාර්මිකයන් ${total > 0 ? total + "+" : ""} සොයන්න. WhatsApp මිල ගණන් සසඳන්න. ශ්‍රම ගාස්තුව වර්ග අඩියකට රු. ${LABOUR.min}–${LABOUR.max}. ඔබේ ව්‍යාපෘතිය නොමිලේ පළ කරන්න.`
const SITE = 'https://wedahub.lk'

const FAQS = [
  { q: `${districtLabel} හි ටයිල් කාර්මික ගාස්තු කීයද?`, a: `${districtLabel} හි ටයිල් ප්‍රමාණය සහ රටාව අනුව ශ්‍රම ගාස්තුව සාමාන්‍යයෙන් වර්ග අඩියකට රු. ${LABOUR.min}–${LABOUR.max} වේ. ඇලවුම් ද්‍රව්‍ය, ග්‍රවුට් සහ මට්ටම් කිරීමේ ක්ලිප් සමඟ, ටයිල් මිල හැර වර්ග අඩියකට රු. ${cost.low}–${cost.high} පමණ වැය වේ. සම්පූර්ණ ඇස්තමේන්තුවක් සඳහා නොමිලේ වැඩHUB ගණකය භාවිත කරන්න.` },
  { q: `${districtLabel} හි විශ්වාසවන්ත ටයිල් කාර්මිකයෙකු සොයාගන්නේ කෙසේද?`, a: `වැඩ විස්තර සමඟ ඔබේ ව්‍යාපෘතිය වැඩHUB හි නොමිලේ පළ කරන්න. ${districtLabel} හි (${townLabels.slice(0,3).join(', ')} සහ අවට නගරවල) සත්‍යාපිත කාර්මිකයන් WhatsApp හරහා ලංසු එවනු ඇත. තෝරාගැනීමට පෙර පළපුරුද්ද, සමාලෝචන සහ මිල ගණන් සසඳන්න.` },
  { q: `${districtLabel} හි සේවාව ලබාදෙන ප්‍රදේශ මොනවාද?`, a: `වැඩHUB සේවා සපයන්නන් ${townLabels.join(', ')} ඇතුළු ${districtLabel} දිස්ත්‍රික්කයේ ප්‍රධාන නගරවල සේවය සපයයි.` },
  { q: 'වැඩHUB හරහා කාර්මිකයෙකු සොයාගැනීම නොමිලේද?', a: 'ඔව්. නිවාස හිමියන්ට ව්‍යාපෘති පළ කිරීම සහ ලංසු ලබාගැනීම සම්පූර්ණයෙන් නොමිලේය. වැඩHUB කොමිස් අය නොකරයි. ඔබ WhatsApp හරහා කාර්මිකයා සමඟ සෘජුව ගනුදෙනු කරයි.' },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(f => ({ '@type': 'Question', name: sinhalaText(f.q), acceptedAnswer: { '@type': 'Answer', text: sinhalaText(f.a) } })),
})

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Tiling services in ${district.name}`,
  description: pageDesc,
  provider: { '@type': 'Organization', name: 'වැඩHUB', url: SITE },
  areaServed: { '@type': 'AdministrativeArea', name: `${district.name} District, Sri Lanka` },
  url: `${SITE}${districtPath(district)}`,
})

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=600')
---

<Layout title={sinhalaText(pageTitle)} description={sinhalaText(pageDesc)} noindex={isThin}>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <script slot="head" type="application/ld+json" set:html={serviceSchema} />

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#0B0B0B 0%,#0B0B0B 100%);padding:32px 20px 30px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:960px;margin:0 auto;">
      <Breadcrumbs items={[{ name: 'Find Tilers', href: '/providers?type=tiler' }, { name: district.name }]} light />
      <h1 style="font-family: var(--th-display);font-size:clamp(22px,4.5vw,32px);font-weight:700;color:#fff;margin:0 0 8px;">
        <span class="en-text">ටයිල් කාර්මිකයන් — {sinhalaText(district.name)} — Verified Tiling Professionals</span>
        <span class="si-text">{sinhalaText(district.nameSi)} ටයිලර්වරු — සත්‍යාපිත වෘත්තිකයන්</span>
      </h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0 0 18px;line-height:1.7;max-width:640px;">
        <span class="en-text">{sinhalaText(district.region)} Compare verified tilers, see current rates, and get quotes on WhatsApp — free.</span>
        <span class="si-text">{sinhalaText(district.nameSi)} දිස්ත්‍රික්කයේ සත්‍යාපිත ටයිලර්වරුන්ගෙන් නොමිලේ ලංසු ලබා ගන්න.</span>
      </p>
      <a href={`/post-project?district=${encodeURIComponent(district.name)}`}
        style="display:inline-flex;align-items:center;gap:8px;background:#8A6224;color:#fff;border-radius:24px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(212,161,94,0.4);">
        📋 <span class="en-text">Post a Project in {sinhalaText(district.name)}</span><span class="si-text">ව්‍යාපෘතිය පලකරන්න</span>
      </a>
    </div>
  </div>

  <!-- Providers -->
  <div style="background:#F7F7F7;padding:24px 16px 40px;">
    <div style="max-width:960px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0;">{sinhalaText(total > 0 ? `${districtLabel} හි සේවය සපයන ටයිල් වෘත්තිකයන් ${total}` : `${districtLabel} හි ටයිල් වෘත්තිකයන්`)}</h2>
        <a href="/providers" style="font-size:12px;color:#8A6224;font-weight:600;text-decoration:none;">සියල්ල බලන්න ›</a>
      </div>

      {total === 0 ? (
        <div style="text-align:center;padding:36px 20px;background:#fff;border-radius:16px;border:1px solid #E2E2E2;">
          <div style="font-size:36px;margin-bottom:10px;">👷</div>
          <p style="font-size:13px;color:#6E6E6E;margin:0 0 16px;line-height:1.7;">{sinhalaText(district.name)} හි තවම සේවා සපයන්නන් ලැයිස්තුගත වී නැත. අසල කාර්මිකයන්ගෙන් ලංසු ලබාගැනීමට ඔබේ ව්‍යාපෘතිය පළ කරන්න, නැතිනම් පළමු සේවා සපයන්නා ලෙස එක්වන්න.</p>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a href="/post-project" style="display:inline-flex;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">📋 ව්‍යාපෘතියක් පළ කරන්න</a>
            <a href="/join-wedahub" style="display:inline-flex;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">✅ සේවා සපයන්නෙකු ලෙස එක්වන්න</a>
          </div>
        </div>
      ) : (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
          {providers.map(p => {
            const color = avatarColor(p.name || 'P')
            const inits = initials(p.name || 'P')
            const phone = p.whatsapp || p.phone
            const isVerified = ['th_master','th_certified_pro','th_verified'].includes(p.verification_status)
            const coverSrc = p.cover_image || p.profile_image
            const cardHref = p.slug ? `/providers/${p.slug}` : null
            return (
              <div onclick={cardHref ? `location.href='${cardHref}'` : undefined} style={`display:flex;flex-direction:column;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.08);${cardHref ? 'cursor:pointer;' : ''}`}>
                <div style="position:relative;height:160px;flex-shrink:0;">
                  {coverSrc
                    ? <img src={coverSrc} alt={sinhalaText(`${p.name} — ${sinhalaText(district.name)} හි ටයිල් කාර්මිකයා`)} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                        <span style="font-size:42px;font-weight:800;color:rgba(255,255,255,0.85);">{sinhalaText(inits)}</span>
                      </div>
                  }
                  {isVerified && (
                    <span style="position:absolute;top:10px;right:10px;background:#2F6B4F;color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:3px 9px;">✓ සත්‍යාපිත</span>
                  )}
                </div>
                <div style="padding:14px 16px;display:flex;flex-direction:column;flex:1;">
                  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px;">
                    <span style="font-size:15px;font-weight:700;color:#0B0B0B;line-height:1.25;">{sinhalaText(p.name)}</span>
                    {p.daily_rate_min && (
                      <span style="font-size:11px;font-weight:700;color:#8A6224;white-space:nowrap;flex-shrink:0;">රු. {sinhalaText(Number(p.daily_rate_min).toLocaleString())}දිනකට</span>
                    )}
                  </div>
                  <div style="font-size:12px;margin-bottom:8px;">
                    {p.avg_rating > 0
                      ? <span style="color:#f59e0b;">⭐ {sinhalaText(Number(p.avg_rating).toFixed(1))}{sinhalaText(p.review_count ? ` (සමාලෝචන ${p.review_count})` : '')}</span>
                      : <span style="color:#8C8C8C;">අලුත් · තවම සමාලෝචන නැත</span>
                    }
                  </div>
                  <div style="border-top:1px solid #ECECEC;margin-top:auto;padding-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    {p.experience_years > 0 && (
                      <span style="font-size:11px;font-weight:600;color:#2F6B4F;">🛡 {sinhalaText(p.experience_years)}+ වසර</span>
                    )}
                    <span style="font-size:11px;color:#6E6E6E;">📍 {sinhalaText(p.city || p.district)}</span>
                    <div style="margin-left:auto;display:flex;gap:6px;">
                      {phone && (
                        <a href={waLink(phone, p.name)} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()"
                          style="display:inline-flex;align-items:center;background:#25D366;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">💬</a>
                      )}
                      {cardHref && (
                        <a href={cardHref} onclick="event.stopPropagation()"
                          style="display:inline-flex;align-items:center;background:#8A6224;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">බලන්න ›</a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Recent jobs in district -->
  {jobs.length > 0 && (
    <div style="background:#fff;padding:28px 16px;border-top:1px solid #ECECEC;">
      <div style="max-width:720px;margin:0 auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0;">{sinhalaText(district.name)} හි මෑත ටයිල් ව්‍යාපෘති</h2>
          <a href="/jobs" style="font-size:12px;color:#8A6224;font-weight:600;text-decoration:none;">සියල්ල බලන්න ›</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {jobs.map(j => (
            <a href={jobPath(j)} style="display:block;background:#F7F7F7;border:1px solid #E2E2E2;border-radius:14px;padding:14px 16px;text-decoration:none;color:inherit;">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:4px;">
                <span style="font-size:13px;font-weight:700;color:#0B0B0B;">{sinhalaText(j.project_type)}</span>
                <span style="font-size:10px;color:#8C8C8C;white-space:nowrap;flex-shrink:0;">{sinhalaText(timeAgo(j.created_at))}</span>
              </div>
              {j.city && <div style="font-size:11px;color:#6E6E6E;margin-bottom:4px;">📍 {sinhalaText(j.city)}</div>}
              {j.description && <p style="font-size:12px;color:#6E6E6E;margin:0;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{sinhalaText(j.description)}</p>}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Cost snapshot -->
  <div style="background:#F7F7F7;padding:28px 16px;border-top:1px solid #ECECEC;">
    <div style="max-width:720px;margin:0 auto;">
      <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0 0 10px;">{sinhalaText(district.name)} හි ටයිල් වැඩ වියදම ({sinhalaText(year)})</h2>
      <p style="font-size:13px;color:#4A4A4A;line-height:1.9;margin:0 0 14px;">
        {sinhalaText(district.name)} හි ටයිල් වැඩ ශ්‍රම ගාස්තුව <strong>රු. {sinhalaText(LABOUR.min)}–{sinhalaText(LABOUR.max)}/වර්ග අඩි</strong>. ඇලවුම් ද්‍රව්‍ය (C1 රු. {sinhalaText(ADHESIVE_TIERS[0].rate)} – C2TE Rs. {sinhalaText(ADHESIVE_TIERS[2].rate)}/වර්ග අඩි), ග්‍රවුට් රු. {sinhalaText(EXTRAS.grout)}/වර්ග අඩි සහ මට්ටම් කිරීමේ ක්ලිප් රු. {sinhalaText(EXTRAS.levelClips)}/වර්ග අඩි සමඟ ආසන්න වියදම <strong>රු. {sinhalaText(cost.low)}–{sinhalaText(cost.high)} වර්ග අඩියකට</strong> ටයිල් ද්‍රව්‍ය මිලට පෙර.
      </p>
      <a href="https://tilershub.lk/estimator" style="display:inline-flex;align-items:center;gap:7px;background:#8A6224;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
        📐 ඔබේ ටයිල් වැඩ වියදම ගණනය කරන්න →
      </a>
    </div>
  </div>

  <!-- Services + towns + neighbors -->
  <div style="background:#fff;padding:28px 16px 40px;border-top:1px solid #ECECEC;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:22px;">

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0B0B0B;margin:0 0 10px;">{sinhalaText(district.name)} හි ජනප්‍රිය සේවා</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {locServices.map(s => (
            <a href={serviceDistrictPath(s.slug, district)} style="font-size:12px;font-weight:700;color:#8A6224;background:#F5EEE2;border:1px solid #E8DCC6;border-radius:20px;padding:7px 14px;text-decoration:none;">{sinhalaText(s.icon)} {sinhalaText(s.label)} — {sinhalaText(district.name)}</a>
          ))}
        </div>
      </div>

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0B0B0B;margin:0 0 10px;">{sinhalaText(district.name)} දිස්ත්‍රික්කයේ සේවය සපයන ප්‍රදේශ</h2>
        <p style="font-size:13px;color:#6E6E6E;line-height:1.9;margin:0;">
          වැඩHUB වෘත්තිකයන් {sinhalaText(townLabels.join(' · '))} සහ අවට ප්‍රදේශවල සේවය සපයයි.
        </p>
      </div>

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0B0B0B;margin:0 0 10px;">අසල දිස්ත්‍රික්ක</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {neighbors.map(n => (
            <a href={districtPath(n)} style="font-size:12px;font-weight:700;color:#4A4A4A;background:#F7F7F7;border:1px solid #E2E2E2;border-radius:20px;padding:7px 14px;text-decoration:none;">{sinhalaText(n.name)} හි ටයිල් කාර්මිකයන්</a>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div>
        <h2 style="font-size:15px;font-weight:800;color:#0B0B0B;margin:0 0 12px;">{sinhalaText(district.name)} හි කාර්මිකයෙකු සොයාගැනීම — නිතර අසන ප්‍රශ්න</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {FAQS.map(f => (
            <details style="background:#F7F7F7;border:1px solid #E2E2E2;border-radius:12px;padding:14px 16px;">
              <summary style="font-size:13px;font-weight:700;color:#0B0B0B;cursor:pointer;">{sinhalaText(f.q)}</summary>
              <p style="font-size:13px;color:#4A4A4A;line-height:1.8;margin:10px 0 0;">{sinhalaText(f.a)}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- CTA -->
  <div style="background:linear-gradient(135deg,#0B0B0B 0%,#0B0B0B 100%);padding:36px 20px;text-align:center;">
    <h2 style="font-family: var(--th-display);font-size:clamp(18px,4vw,24px);font-weight:700;color:#fff;margin:0 0 10px;">
      <span class="en-text">Need tiling done in {sinhalaText(district.name)}?</span>
      <span class="si-text">{sinhalaText(district.nameSi)} හි ටයිලිං සේවාවක් අවශ්‍යද?</span>
    </h2>
    <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0 0 20px;">
      <span class="en-text">නොමිලේ පළ කර WhatsApp හරහා සත්‍යාපිත කාර්මිකයන්ගෙන් මිල ගණන් ලබාගන්න</span>
      <span class="si-text">නොමිලේ පලකරන්න — WhatsApp හරහා ලංසු ලබා ගන්න</span>
    </p>
    <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:#8A6224;color:#fff;border-radius:24px;padding:13px 28px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(212,161,94,0.45);">
      📋 <span class="en-text">ඔබේ ව්‍යාපෘතිය පළ කරන්න →</span><span class="si-text">ව්‍යාපෘතිය පලකරන්න →</span>
    </a>
  </div>

</Layout>
